<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="OgConverter.App"
             Name="OG Converter"
             RequestedThemeVariant="Dark">
    <!-- Fluent supplies the controls the design system doesn't restyle (scroll viewers, text boxes, progress bars).
         The palette, control themes and text styles in Themes/ sit on top; AppThemeService swaps the palette live. -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://og-converter/Themes/Theme.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://og-converter/Themes/Styles.axaml" />
    </Application.Styles>
</Application>
