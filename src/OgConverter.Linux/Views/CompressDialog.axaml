<v:DialogWindow xmlns="https://github.com/avaloniaui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:c="using:OgConverter.Controls"
                xmlns:v="using:OgConverter.Views"
                x:Class="OgConverter.Views.CompressDialog"
                Title="Compress" Width="600">

    <Border Classes="DialogCard">
        <StackPanel>
            <!-- Header (drag to move) -->
            <Grid Classes="DialogHeader" ColumnDefinitions="Auto,*" Margin="24,22,24,16" PointerPressed="OnHeaderPointerPressed">
                <Border Classes="DialogBadge" Background="{DynamicResource ModeToolsSubtleBrush}">
                    <TextBlock Text="{c:Icon E73F}" Classes="Icon" Foreground="{DynamicResource ModeToolsBrush}" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="HeaderText" Text="Compress" Classes="H2" />
                    <TextBlock x:Name="FileInfoText" Classes="Caption" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                </StackPanel>
            </Grid>

            <ScrollViewer x:Name="BodyScroller" MaxHeight="640" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="24,0,24,0">
                    <!-- Mode -->
                    <Grid ColumnDefinitions="*,10,*">
                        <RadioButton x:Name="LosslessCard" Theme="{StaticResource ModeCard}" GroupName="Mode" HorizontalAlignment="Stretch" IsCheckedChanged="OnModeChanged">
                            <StackPanel>
                                <TextBlock Text="Lossless" FontWeight="SemiBold" />
                                <TextBlock x:Name="LosslessHint" Classes="Caption" FontSize="11.5" TextWrapping="Wrap" Margin="0,3,0,0"
                                           Text="Identical quality. Smaller where the format allows." />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="LossyCard" Grid.Column="2" Theme="{StaticResource ModeCard}" GroupName="Mode" HorizontalAlignment="Stretch" IsCheckedChanged="OnModeChanged">
                            <StackPanel>
                                <TextBlock Text="Lossy" FontWeight="SemiBold" />
                                <TextBlock x:Name="LossyHint" Classes="Caption" FontSize="11.5" TextWrapping="Wrap" Margin="0,3,0,0"
                                           Text="Much smaller files. You choose the quality." />
                            </StackPanel>
                        </RadioButton>
                    </Grid>

                    <!-- Presets -->
                    <StackPanel x:Name="PresetSection" Margin="0,18,0,0">
                        <TextBlock Text="Preset" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <WrapPanel x:Name="PresetPanel" />
                    </StackPanel>

                    <!-- Settings for this file kind and mode (built in code) -->
                    <Border Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="16,14" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="SETTINGS" Classes="Overline" Margin="0,0,0,12" />
                            <StackPanel x:Name="SettingsPanel" />
                        </StackPanel>
                    </Border>

                    <!-- A helper this choice needs isn't installed (FFmpeg, Guetzli) -->
                    <v:ToolMissingPanel x:Name="ToolMissing" Margin="0,14,0,0" Installed="OnToolInstalled" />

                    <!-- Summary -->
                    <Border Classes="StatusLine" Margin="0,14,0,0">
                        <Grid ColumnDefinitions="Auto,*">
                            <TextBlock x:Name="SummaryIcon" Text="{c:Icon E946}" Classes="Icon" FontSize="12" Margin="0,1,8,0" VerticalAlignment="Top" />
                            <StackPanel Grid.Column="1">
                                <TextBlock x:Name="SummaryText" FontSize="12" TextWrapping="Wrap" />
                                <TextBlock x:Name="WarningText" FontSize="11.5" TextWrapping="Wrap" Margin="0,4,0,0"
                                           Foreground="{DynamicResource WarningBrush}" IsVisible="False" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Footer -->
            <Border Classes="DialogFooter" Margin="0,20,0,0">
                <Grid>
                    <Button x:Name="ResetButton" Theme="{StaticResource GhostButton}" Content="Reset to defaults" HorizontalAlignment="Left"
                            FontSize="12" Padding="10,5" Click="OnResetClick" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel" IsCancel="True" Click="OnCancelClick" Margin="0,0,8,0" MinWidth="88" />
                        <Button x:Name="ConfirmButton" Theme="{StaticResource AccentButton}" Content="Compress" IsDefault="True" Click="OnConfirmClick" MinWidth="88" />
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </Border>
</v:DialogWindow>
