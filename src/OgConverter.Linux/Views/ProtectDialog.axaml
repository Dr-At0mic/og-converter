<v:DialogWindow xmlns="https://github.com/avaloniaui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:c="using:OgConverter.Controls"
                xmlns:v="using:OgConverter.Views"
                x:Class="OgConverter.Views.ProtectDialog"
                Title="Protect with a password" Width="580">

    <Window.Styles>
        <Style Selector="CheckBox.Option">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
    </Window.Styles>

    <Border Classes="DialogCard">
        <StackPanel>
            <!-- Header (drag to move) -->
            <Grid Classes="DialogHeader" ColumnDefinitions="Auto,*" Margin="24,22,24,16" PointerPressed="OnHeaderPointerPressed">
                <Border Classes="DialogBadge" Background="{DynamicResource ModeActionsSubtleBrush}">
                    <TextBlock Text="{c:Icon E72E}" Classes="Icon" Foreground="{DynamicResource ModeActionsBrush}" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Protect with a password" Classes="H2" />
                    <TextBlock x:Name="FileInfoText" Classes="Caption" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                </StackPanel>
            </Grid>

            <ScrollViewer x:Name="BodyScroller" MaxHeight="640" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="24,0,24,0">

                    <!-- Method -->
                    <TextBlock Text="Method" Classes="FieldLabel" />
                    <StackPanel x:Name="MethodList" />

                    <!-- Password -->
                    <Grid Margin="0,10,0,8">
                        <TextBlock Text="Password" FontWeight="SemiBold" VerticalAlignment="Bottom" />
                        <Button Theme="{StaticResource GhostButton}" HorizontalAlignment="Right" Padding="8,3" FontSize="12" Click="OnGenerateClick"
                                ToolTip.Tip="Create a strong random password and copy it to the clipboard">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{c:Icon E8D7}" Classes="Icon" FontSize="11" Margin="0,0,6,0" />
                                <TextBlock Text="Generate strong password" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <TextBox x:Name="PasswordInput" Classes="Password" TextChanged="OnTextChanged" />

                    <!-- Strength meter -->
                    <Grid Margin="0,8,0,0" ColumnDefinitions="*,4,*,4,*,4,*,Auto">
                        <Border x:Name="Strength0" Grid.Column="0" Height="4" CornerRadius="2" Background="{DynamicResource BorderStrongBrush}" />
                        <Border x:Name="Strength1" Grid.Column="2" Height="4" CornerRadius="2" Background="{DynamicResource BorderStrongBrush}" />
                        <Border x:Name="Strength2" Grid.Column="4" Height="4" CornerRadius="2" Background="{DynamicResource BorderStrongBrush}" />
                        <Border x:Name="Strength3" Grid.Column="6" Height="4" CornerRadius="2" Background="{DynamicResource BorderStrongBrush}" />
                        <TextBlock x:Name="StrengthText" Grid.Column="7" FontSize="11.5" Foreground="{DynamicResource TextTertiaryBrush}" Margin="10,0,0,0" MinWidth="70" />
                    </Grid>

                    <TextBlock Text="Confirm password" Classes="FieldLabel" Margin="0,14,0,8" />
                    <TextBox x:Name="ConfirmInput" Classes="Password" TextChanged="OnTextChanged" />
                    <CheckBox x:Name="ShowPasswordCheck" Content="Show password" Margin="0,12,0,0" FontSize="12.5" IsCheckedChanged="OnShowPasswordChanged" />

                    <!-- Per-method settings -->
                    <Border Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,18,0,0">
                        <StackPanel>
                            <TextBlock Text="ENCRYPTION SETTINGS" Classes="Overline" Margin="0,0,0,12" />

                            <!-- PDF -->
                            <StackPanel x:Name="PdfOptions">
                                <TextBlock Text="Encryption" Classes="FieldLabel" />
                                <ComboBox x:Name="PdfCipherCombo" SelectedIndex="0" HorizontalAlignment="Stretch" SelectionChanged="OnSelectionChanged">
                                    <ComboBoxItem Content="AES-256 (PDF 2.0) · recommended" />
                                    <ComboBoxItem Content="AES-128 (PDF 1.6, for older readers)" />
                                    <ComboBoxItem Content="RC4 128-bit (legacy, weak)" />
                                </ComboBox>
                                <TextBlock Text="Allow people who open it to" Classes="FieldLabel" Margin="0,16,0,10" />
                                <WrapPanel>
                                    <CheckBox x:Name="AllowPrintCheck" Classes="Option" Content="Print" IsChecked="True" Width="150" IsCheckedChanged="OnInputChanged" />
                                    <CheckBox x:Name="AllowCopyCheck" Classes="Option" Content="Copy text and images" IsChecked="True" Width="180" IsCheckedChanged="OnInputChanged" />
                                    <CheckBox x:Name="AllowEditCheck" Classes="Option" Content="Edit pages" IsChecked="True" Width="150" IsCheckedChanged="OnInputChanged" />
                                    <CheckBox x:Name="AllowCommentCheck" Classes="Option" Content="Comment and fill forms" IsChecked="True" Width="180" IsCheckedChanged="OnInputChanged" />
                                </WrapPanel>
                                <StackPanel x:Name="PermissionsPasswordPanel" IsVisible="False">
                                    <TextBlock Text="Permissions password (optional)" Classes="FieldLabel" Margin="0,6,0,8" />
                                    <TextBox x:Name="PermissionsPasswordInput" Classes="Password" TextChanged="OnTextChanged" />
                                    <TextBlock Classes="Caption" FontSize="11.5" Margin="0,6,0,0"
                                               Text="Lets you lift the restrictions later. Leave blank to make them permanent. Restrictions are honoured by PDF readers, not enforced by the encryption itself." />
                                </StackPanel>
                            </StackPanel>

                            <!-- Office -->
                            <StackPanel x:Name="OfficeOptions">
                                <TextBlock x:Name="OfficeCipherText" Classes="Body" FontSize="12.5" />
                                <TextBlock Text="Password to edit (optional)" Classes="FieldLabel" Margin="0,14,0,8" />
                                <TextBox x:Name="ModifyPasswordInput" Classes="Password" TextChanged="OnTextChanged" />
                                <TextBlock Classes="Caption" FontSize="11.5" Margin="0,6,0,0"
                                           Text="Anyone with the open password can read it; saving changes will also need this one." />
                            </StackPanel>

                            <!-- Encrypted file -->
                            <StackPanel x:Name="VaultOptions">
                                <TextBlock Text="Cipher" Classes="FieldLabel" />
                                <ComboBox x:Name="VaultCipherCombo" SelectedIndex="0" HorizontalAlignment="Stretch" SelectionChanged="OnSelectionChanged">
                                    <ComboBoxItem Content="AES-256-GCM · recommended" />
                                    <ComboBoxItem x:Name="ChaChaItem" Content="ChaCha20-Poly1305" />
                                </ComboBox>
                                <TextBlock Text="Key derivation" Classes="FieldLabel" Margin="0,14,0,8" />
                                <ComboBox x:Name="KdfCombo" SelectedIndex="0" HorizontalAlignment="Stretch" SelectionChanged="OnSelectionChanged">
                                    <ComboBoxItem Content="Argon2id, 64 MiB memory-hard · recommended" />
                                    <ComboBoxItem Content="PBKDF2-HMAC-SHA512, 210,000 rounds" />
                                </ComboBox>
                                <TextBlock x:Name="VaultNote" Classes="Caption" FontSize="11.5" Margin="0,8,0,0" />
                            </StackPanel>

                            <!-- Password-protected archive -->
                            <StackPanel x:Name="ZipOptions">
                                <TextBlock Text="Archive format" Classes="FieldLabel" />
                                <ComboBox x:Name="ArchiveFormatCombo" SelectedIndex="0" HorizontalAlignment="Stretch" SelectionChanged="OnSelectionChanged">
                                    <ComboBoxItem Content="ZIP · opens on every computer" Tag="zip" />
                                    <ComboBoxItem Content="7z · AES-256, usually the smallest" Tag="7z" />
                                    <ComboBoxItem Content="RAR · AES-256 (made with rar)" Tag="rar" />
                                </ComboBox>

                                <StackPanel x:Name="ZipCipherPanel">
                                    <TextBlock Text="Encryption" Classes="FieldLabel" Margin="0,14,0,8" />
                                    <ComboBox x:Name="ZipCipherCombo" SelectedIndex="0" HorizontalAlignment="Stretch" SelectionChanged="OnSelectionChanged">
                                        <ComboBoxItem Content="AES-256 (WinZip AES) · recommended" />
                                        <ComboBoxItem Content="ZipCrypto (legacy, weak)" />
                                    </ComboBox>
                                </StackPanel>
                                <CheckBox x:Name="EncryptNamesCheck" Classes="Option" IsChecked="True" Margin="0,14,0,0" IsCheckedChanged="OnInputChanged">
                                    <TextBlock Text="Encrypt file names too, so nothing is visible without the password" TextWrapping="Wrap" />
                                </CheckBox>

                                <TextBlock Text="Compression" Classes="FieldLabel" Margin="0,14,0,8" />
                                <ComboBox x:Name="ArchiveLevelCombo" SelectedIndex="1" HorizontalAlignment="Stretch" SelectionChanged="OnSelectionChanged">
                                    <ComboBoxItem Content="Store (no compression, fastest)" Tag="store" />
                                    <ComboBoxItem Content="Normal" Tag="normal" />
                                    <ComboBoxItem Content="Maximum (smaller, slower)" Tag="max" />
                                </ComboBox>

                                <v:ToolMissingPanel x:Name="ToolMissing" Margin="0,14,0,0" Installed="OnToolInstalled" />
                                <TextBlock x:Name="ZipNote" Classes="Caption" FontSize="11.5" Margin="0,8,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Validation / hint -->
                    <Border Classes="StatusLine" Margin="0,14,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="StatusIcon" Classes="Icon" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Top" />
                            <TextBlock x:Name="StatusText" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" MaxWidth="410" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Footer -->
            <Border Classes="DialogFooter" Margin="0,20,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" IsCancel="True" Click="OnCancelClick" Margin="0,0,8,0" MinWidth="88" />
                    <Button x:Name="ConfirmButton" Theme="{StaticResource AccentButton}" Content="Protect" IsDefault="True" Click="OnConfirmClick" MinWidth="88" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</v:DialogWindow>
