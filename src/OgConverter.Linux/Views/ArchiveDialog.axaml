<v:DialogWindow xmlns="https://github.com/avaloniaui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:c="using:OgConverter.Controls"
                xmlns:v="using:OgConverter.Views"
                x:Class="OgConverter.Views.ArchiveDialog"
                Title="Archive" Width="600">

    <Border Classes="DialogCard">
        <StackPanel>
            <!-- Header (drag to move) -->
            <Grid Classes="DialogHeader" ColumnDefinitions="Auto,*" Margin="24,22,24,16" PointerPressed="OnHeaderPointerPressed">
                <Border Classes="DialogBadge" Background="{DynamicResource ModeActionsSubtleBrush}">
                    <TextBlock Text="{c:Icon E7B8}" Classes="Icon" Foreground="{DynamicResource ModeActionsBrush}" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Create archive" Classes="H2" />
                    <TextBlock x:Name="FileInfoText" Classes="Caption" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                </StackPanel>
            </Grid>

            <ScrollViewer x:Name="BodyScroller" MaxHeight="640" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="24,0,24,0">
                    <!-- Format -->
                    <TextBlock Text="Format" Classes="FieldLabel" />
                    <WrapPanel x:Name="PresetPanel" />
                    <ComboBox x:Name="FormatCombo" Margin="0,4,0,0" HorizontalAlignment="Stretch" SelectionChanged="OnFormatChanged" MaxDropDownHeight="420" />

                    <!-- Compression settings for the chosen format (built in code) -->
                    <Border Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="16,14" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="COMPRESSION" Classes="Overline" Margin="0,0,0,12" />
                            <StackPanel x:Name="SettingsPanel" />
                        </StackPanel>
                    </Border>

                    <!-- Advanced: password -->
                    <Button Theme="{StaticResource GhostButton}" HorizontalAlignment="Left" Margin="-8,12,0,0" Padding="8,4" Click="OnAdvancedToggled">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="AdvancedChevron" Text="{c:Icon E76C}" Classes="Icon" FontSize="10" Margin="0,0,8,0" />
                            <TextBlock Text="Advanced: password protection" FontWeight="SemiBold" />
                            <TextBlock x:Name="AdvancedBadge" Classes="Caption" FontSize="11.5" VerticalAlignment="Center" Margin="10,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Border x:Name="AdvancedPanel" IsVisible="False" Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="16,14" Margin="0,8,0,0">
                        <StackPanel>
                            <StackPanel x:Name="PasswordFields">
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="Password (optional)" FontWeight="SemiBold" VerticalAlignment="Bottom" />
                                    <Button Theme="{StaticResource GhostButton}" HorizontalAlignment="Right" Padding="8,3" FontSize="12" Click="OnGenerateClick"
                                            ToolTip.Tip="Create a strong random password and copy it to the clipboard">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{c:Icon E8D7}" Classes="Icon" FontSize="11" Margin="0,0,6,0" />
                                            <TextBlock Text="Generate strong password" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <TextBox x:Name="PasswordInput" Classes="Password" TextChanged="OnPasswordTextChanged" />
                                <TextBlock Text="Confirm password" Classes="FieldLabel" Margin="0,12,0,8" />
                                <TextBox x:Name="ConfirmInput" Classes="Password" TextChanged="OnPasswordTextChanged" />
                                <CheckBox x:Name="ShowPasswordCheck" Content="Show password" Margin="0,10,0,0" FontSize="12.5" IsCheckedChanged="OnShowPasswordChanged" />

                                <StackPanel x:Name="ZipCipherPanel">
                                    <TextBlock Text="Encryption" Classes="FieldLabel" Margin="0,14,0,8" />
                                    <ComboBox x:Name="ZipCipherCombo" SelectedIndex="0" HorizontalAlignment="Stretch" SelectionChanged="OnPasswordSelectionChanged">
                                        <ComboBoxItem Content="AES-256 (WinZip AES) · recommended" />
                                        <ComboBoxItem Content="ZipCrypto (legacy, weak; opens everywhere)" />
                                    </ComboBox>
                                </StackPanel>
                                <CheckBox x:Name="EncryptNamesCheck" IsChecked="True" Margin="0,14,0,0" FontSize="12.5" IsCheckedChanged="OnPasswordChanged">
                                    <TextBlock Text="Encrypt file names too, so nothing is visible without the password" TextWrapping="Wrap" />
                                </CheckBox>
                            </StackPanel>
                            <TextBlock x:Name="PasswordNote" Classes="Caption" FontSize="11.5" Margin="0,10,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- A helper this choice needs isn't installed -->
                    <v:ToolMissingPanel x:Name="ToolMissing" Margin="0,14,0,0" Installed="OnToolInstalled" />

                    <!-- Summary -->
                    <Border Classes="StatusLine" Margin="0,14,0,0">
                        <Grid ColumnDefinitions="Auto,*">
                            <TextBlock x:Name="SummaryIcon" Text="{c:Icon E946}" Classes="Icon" FontSize="12" Margin="0,1,8,0" VerticalAlignment="Top" />
                            <StackPanel Grid.Column="1">
                                <TextBlock x:Name="SummaryText" FontSize="12" TextWrapping="Wrap" />
                                <TextBlock x:Name="WarningText" FontSize="11.5" TextWrapping="Wrap" Margin="0,4,0,0"
                                           Foreground="{DynamicResource WarningBrush}" IsVisible="False" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Footer -->
            <Border Classes="DialogFooter" Margin="0,20,0,0">
                <Grid>
                    <Button Theme="{StaticResource GhostButton}" Content="Reset to defaults" HorizontalAlignment="Left"
                            FontSize="12" Padding="10,5" Click="OnResetClick" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel" IsCancel="True" Click="OnCancelClick" Margin="0,0,8,0" MinWidth="88" />
                        <Button x:Name="ConfirmButton" Theme="{StaticResource AccentButton}" Content="Create" IsDefault="True" Click="OnConfirmClick" MinWidth="88" />
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </Border>
</v:DialogWindow>
