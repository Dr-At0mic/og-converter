<Window x:Class="OgConverter.Views.ImagesToPdfDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pictures to PDF"
        Icon="pack://application:,,,/Assets/og-converter.ico"
        Width="600" Height="560" MinWidth="480" MinHeight="420"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResizeWithGrip" Topmost="True" ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        Foreground="{DynamicResource TextPrimaryBrush}"
        TextOptions.TextFormattingMode="Display">

    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderStrongBrush}"
            BorderThickness="1" CornerRadius="12" Margin="16" Effect="{StaticResource FlyoutShadow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header (drag to move) -->
            <Grid Grid.Row="0" MouseLeftButtonDown="OnHeaderMouseDown" Background="Transparent" Margin="24,22,24,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="36" Height="36" CornerRadius="8" Background="{DynamicResource ModeConvertSubtleBrush}" Margin="0,0,14,0" VerticalAlignment="Top">
                    <TextBlock Text="&#xE8A5;" Style="{StaticResource Icon}" Foreground="{DynamicResource ModeConvertBrush}" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText" Text="Pictures to PDF" Style="{StaticResource H2}" />
                    <TextBlock Text="Make one PDF with a page per picture, or a separate PDF for each."
                               Style="{StaticResource Caption}" Margin="0,2,0,0" />
                </StackPanel>
            </Grid>

            <!-- Choice -->
            <StackPanel Grid.Row="1" Margin="24,0,24,14">
                <RadioButton x:Name="MergeRadio" GroupName="PdfOutput" Margin="0,0,0,10"
                             Content="Merge into a single PDF: every picture in one PDF, in the order below" Checked="OnChoiceChanged" />
                <RadioButton x:Name="EachRadio" GroupName="PdfOutput"
                             Content="Create individual PDFs: one PDF per picture" Checked="OnChoiceChanged" />
            </StackPanel>

            <!-- Page order + side buttons -->
            <Grid Grid.Row="2" Margin="24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                    <ListBox x:Name="FileList" Background="Transparent" BorderThickness="0" Padding="4"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             SelectionChanged="OnSelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Grid Margin="0,1">
                                                <Border x:Name="bd" Background="Transparent" CornerRadius="6" Padding="10,8">
                                                    <ContentPresenter />
                                                </Border>
                                                <Border x:Name="pip" Width="3" Height="16" CornerRadius="1.5" Background="{DynamicResource AccentBrush}"
                                                        HorizontalAlignment="Left" Visibility="Collapsed" />
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                                                    <Setter TargetName="pip" Property="Visibility" Value="Visible" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid ToolTip="{Binding Path}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Index}" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="12" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="&#xE91B;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,10,0" />
                                    <TextBlock Grid.Column="2" Text="{Binding FileName}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <StackPanel Grid.Column="1" Margin="12,0,0,0" Width="124">
                    <Button x:Name="UpButton" Click="OnMoveUpClick" Margin="0,0,0,6">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74A;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="Move up" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="DownButton" Click="OnMoveDownClick" Margin="0,0,0,18">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74B;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="Move down" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="RemoveButton" Click="OnRemoveClick">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="Remove" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Summary / validation -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="24,14,24,0">
                <TextBlock x:Name="SummaryIcon" Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0" />
                <TextBlock x:Name="SummaryText" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" MaxWidth="500" />
            </StackPanel>

            <!-- Footer -->
            <Border Grid.Row="4" Background="{DynamicResource WindowBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0"
                    CornerRadius="0,0,12,12" Padding="24,14" Margin="0,18,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" IsCancel="True" Click="OnCancelClick" Margin="0,0,8,0" MinWidth="88" />
                    <Button x:Name="CreateButton" Style="{StaticResource AccentButton}" Content="Create" IsDefault="True" Click="OnCreateClick" MinWidth="88" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
