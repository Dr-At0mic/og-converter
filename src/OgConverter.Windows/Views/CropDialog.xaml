<Window x:Class="OgConverter.Views.CropDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:OgConverter.Controls"
        Title="Crop"
        Icon="pack://application:,,,/Assets/og-converter.ico"
        Width="980" Height="760" MinWidth="680" MinHeight="520"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResizeWithGrip" Topmost="True" ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        Foreground="{DynamicResource TextPrimaryBrush}"
        TextOptions.TextFormattingMode="Display"
        PreviewKeyDown="OnPreviewKeyDown">

    <Window.Resources>
        <!-- Aspect ratio chip -->
        <Style x:Key="RatioChip" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="GroupName" Value="Ratio" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" CornerRadius="14" Padding="12,5">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource TextTertiaryBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderStrongBrush}"
            BorderThickness="1" CornerRadius="12" Margin="16" Effect="{StaticResource FlyoutShadow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header (drag to move) -->
            <Grid MouseLeftButtonDown="OnHeaderMouseDown" Background="Transparent" Margin="24,20,24,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="36" Height="36" CornerRadius="8" Background="{DynamicResource ModeToolsSubtleBrush}" Margin="0,0,14,0" VerticalAlignment="Top">
                    <TextBlock Text="&#xE7A8;" Style="{StaticResource Icon}" Foreground="{DynamicResource ModeToolsBrush}" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText" Text="Crop image" Style="{StaticResource H2}" />
                    <TextBlock x:Name="FileInfoText" Style="{StaticResource Caption}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                </StackPanel>
            </Grid>

            <!-- Preview -->
            <Border Grid.Row="1" Background="{DynamicResource WindowBrush}" CornerRadius="8" Margin="24,0">
                <Grid>
                    <controls:CropCanvas x:Name="Cropper" SelectionChanged="OnSelectionChanged" ViewChanged="OnViewChanged" />
                    <TextBlock x:Name="StatusText" Text="Loading preview…" Style="{StaticResource Caption}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="420" />
                </Grid>
            </Border>

            <!-- Video: which frame to preview -->
            <Grid x:Name="FramePanel" Grid.Row="2" Margin="24,12,24,0" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Preview frame" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,12,0" />
                <Slider x:Name="FrameSlider" Grid.Column="1" VerticalAlignment="Center" ValueChanged="OnFrameSliderChanged" />
                <TextBlock x:Name="FrameTimeText" Grid.Column="2" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="12,0,0,0"
                           FontFamily="Cascadia Mono, Consolas, Segoe UI" MinWidth="64" TextAlignment="Right" />
            </Grid>

            <!-- Aspect ratio + size -->
            <Grid Grid.Row="3" Margin="24,14,24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <WrapPanel x:Name="RatioPanel" VerticalAlignment="Center">
                    <RadioButton Style="{StaticResource RatioChip}" Content="Free" Tag="free" IsChecked="True" Checked="OnRatioChecked" />
                    <RadioButton Style="{StaticResource RatioChip}" Content="Original" Tag="original" Checked="OnRatioChecked" />
                    <RadioButton Style="{StaticResource RatioChip}" Content="Square" Tag="1:1" Checked="OnRatioChecked" />
                    <RadioButton Style="{StaticResource RatioChip}" Content="4:3" Tag="4:3" Checked="OnRatioChecked" />
                    <RadioButton Style="{StaticResource RatioChip}" Content="3:2" Tag="3:2" Checked="OnRatioChecked" />
                    <RadioButton Style="{StaticResource RatioChip}" Content="16:9" Tag="16:9" Checked="OnRatioChecked" />
                    <RadioButton Style="{StaticResource RatioChip}" Content="4:5" Tag="4:5" Checked="OnRatioChecked" />
                    <RadioButton Style="{StaticResource RatioChip}" Content="9:16" Tag="9:16" Checked="OnRatioChecked" />
                </WrapPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="12,2,0,0">
                    <!-- Zoom: long pictures (a README saved as one image) are a thin strip when shown whole -->
                    <Button x:Name="ZoomOutButton" Style="{StaticResource GhostButton}" Content="−" Click="OnZoomOutClick" FontSize="13" MinWidth="28"
                            ToolTip="Zoom out (Ctrl+−)" />
                    <TextBlock x:Name="ZoomText" FontFamily="Cascadia Mono, Consolas, Segoe UI" FontSize="12" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}" MinWidth="42" TextAlignment="Center" />
                    <Button x:Name="ZoomInButton" Style="{StaticResource GhostButton}" Content="+" Click="OnZoomInClick" FontSize="13" MinWidth="28"
                            ToolTip="Zoom in (Ctrl+= or Ctrl+scroll)" />
                    <Button Style="{StaticResource GhostButton}" Content="Fit" Click="OnZoomFitClick" FontSize="12" ToolTip="Show the whole picture (Ctrl+0)" />
                    <Button Style="{StaticResource GhostButton}" Content="Width" Click="OnZoomWidthClick" FontSize="12" Margin="0,0,14,0"
                            ToolTip="Fill the width and go to the top of the selection: for long pictures" />
                    <TextBlock x:Name="SizeText" FontFamily="Cascadia Mono, Consolas, Segoe UI" FontSize="12" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,10,0" />
                    <Button Style="{StaticResource GhostButton}" Content="Reset" Click="OnResetClick" FontSize="12" ToolTip="Select the whole picture again" />
                </StackPanel>
            </Grid>

            <!-- Footer -->
            <Border Grid.Row="4" Background="{DynamicResource WindowBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0"
                    CornerRadius="0,0,12,12" Padding="24,14" Margin="0,10,0,0">
                <Grid>
                    <TextBlock Style="{StaticResource Caption}" VerticalAlignment="Center" FontSize="11.5" Margin="0,0,220,0" TextTrimming="CharacterEllipsis">
                        Drag the handles or draw a new box  ·  Ctrl+scroll zooms, scroll pans  ·  Arrow keys nudge (Shift = 10 px)  ·  Enter crops
                    </TextBlock>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel" IsCancel="True" Click="OnCancelClick" Margin="0,0,8,0" MinWidth="88" />
                        <Button x:Name="ConfirmButton" Style="{StaticResource AccentButton}" Content="Crop" IsDefault="True" Click="OnConfirmClick" MinWidth="88" IsEnabled="False" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
