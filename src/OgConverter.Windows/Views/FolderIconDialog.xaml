<Window x:Class="OgConverter.Views.FolderIconDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Folder icon"
        Icon="pack://application:,,,/Assets/og-converter.ico"
        Width="680" Height="600" MinWidth="560" MinHeight="480"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResizeWithGrip" Topmost="True" ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        Foreground="{DynamicResource TextPrimaryBrush}"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <!-- Colour swatches: a filled circle, ringed in the accent when picked -->
        <Style x:Key="SwatchItem" TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ring" Width="34" Height="34" CornerRadius="17" Margin="0,0,6,6" BorderThickness="2"
                                BorderBrush="Transparent" Background="Transparent" ToolTip="{Binding Name}">
                            <Ellipse Width="24" Height="24" Fill="{Binding Fill}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ring" Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ring" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Symbol tiles -->
        <Style x:Key="SymbolItem" TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="tile" Width="48" Height="48" CornerRadius="8" Margin="0,0,6,6" BorderThickness="1"
                                BorderBrush="Transparent" Background="Transparent" ToolTip="{Binding Name}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="tile" Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="tile" Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
                                <Setter TargetName="tile" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderStrongBrush}"
            BorderThickness="1" CornerRadius="12" Margin="16" Effect="{StaticResource FlyoutShadow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header (drag to move) -->
            <Grid Grid.Row="0" MouseLeftButtonDown="OnHeaderMouseDown" Background="Transparent" Margin="24,22,24,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="36" Height="36" CornerRadius="8" Background="{DynamicResource ModeActionsSubtleBrush}" Margin="0,0,14,0" VerticalAlignment="Top">
                    <TextBlock Text="&#xE8B7;" Style="{StaticResource Icon}" Foreground="{DynamicResource ModeActionsBrush}" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Folder icon" Style="{StaticResource H2}" />
                    <TextBlock x:Name="SubtitleText" Style="{StaticResource Caption}" Margin="0,2,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>

            <!-- Preview | colours and symbols -->
            <Grid Grid.Row="1" Margin="24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="196" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,20,0">
                    <Border Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10"
                            Width="176" Height="176">
                        <Image x:Name="PreviewImage" Width="144" Height="144" RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>
                    <TextBlock x:Name="PreviewCaption" Style="{StaticResource Caption}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,10,0,0" />
                </StackPanel>

                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Colour" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <ListBox x:Name="ColorList" Grid.Row="1" Background="Transparent" BorderThickness="0" Padding="0"
                             ItemContainerStyle="{StaticResource SwatchItem}" SelectionChanged="OnColorChanged"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                    </ListBox>

                    <TextBlock Grid.Row="2" Text="Symbol" FontWeight="SemiBold" Margin="0,12,0,8" />
                    <Border Grid.Row="3" Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="6,6,0,0">
                        <ListBox x:Name="SymbolList" Background="Transparent" BorderThickness="0" Padding="0"
                                 ItemContainerStyle="{StaticResource SymbolItem}" SelectionChanged="OnSymbolChanged"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Width="24" Height="24">
                                        <Path Data="{Binding Geometry}" Fill="{DynamicResource TextPrimaryBrush}" Stretch="Uniform" />
                                        <TextBlock Text="&#xE8B7;" Style="{StaticResource Icon}" FontSize="20" Foreground="{DynamicResource TextTertiaryBrush}"
                                                   Visibility="{Binding NoneVisibility}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Grid>
            </Grid>

            <!-- Footer -->
            <Border Grid.Row="2" Background="{DynamicResource WindowBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0"
                    CornerRadius="0,0,12,12" Padding="24,14" Margin="0,18,0,0">
                <Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button Click="OnPictureClick" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE91B;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="Use a picture…" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="ResetButton" Click="OnResetClick" ToolTip="Back to the standard folder icon">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="Reset to default" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel" IsCancel="True" Click="OnCancelClick" Margin="0,0,8,0" MinWidth="88" />
                        <Button x:Name="ApplyButton" Style="{StaticResource AccentButton}" Content="Apply" IsDefault="True" Click="OnApplyClick" MinWidth="88" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
