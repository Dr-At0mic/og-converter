<Window x:Class="OgConverter.Views.TrimDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:OgConverter.Controls"
        Title="Trim video"
        Icon="pack://application:,,,/Assets/og-converter.ico"
        Width="900" Height="640" MinWidth="640" MinHeight="500"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResizeWithGrip" Topmost="True" ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        Foreground="{DynamicResource TextPrimaryBrush}"
        TextOptions.TextFormattingMode="Display">

    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderStrongBrush}"
            BorderThickness="1" CornerRadius="12" Margin="16" Effect="{StaticResource FlyoutShadow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header (drag to move) -->
            <Grid MouseLeftButtonDown="OnHeaderMouseDown" Background="Transparent" Margin="24,20,24,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="36" Height="36" CornerRadius="8" Background="{DynamicResource ModeToolsSubtleBrush}" Margin="0,0,14,0" VerticalAlignment="Top">
                    <TextBlock Text="&#xE8C6;" Style="{StaticResource Icon}" Foreground="{DynamicResource ModeToolsBrush}" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Trim video" Style="{StaticResource H2}" />
                    <TextBlock x:Name="FileInfoText" Style="{StaticResource Caption}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                </StackPanel>
            </Grid>

            <!-- Start and end frames -->
            <Grid Grid.Row="1" Margin="24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Background="{DynamicResource WindowBrush}" CornerRadius="8">
                    <Grid>
                        <Image x:Name="StartImage" Stretch="Uniform" Margin="8" RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock x:Name="StartStatus" Text="Loading…" Style="{StaticResource Caption}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                </Border>
                <Border Grid.Column="2" Background="{DynamicResource WindowBrush}" CornerRadius="8">
                    <Grid>
                        <Image x:Name="EndImage" Stretch="Uniform" Margin="8" RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock x:Name="EndStatus" Text="Loading…" Style="{StaticResource Caption}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                </Border>
                <TextBlock Grid.Row="1" Text="First frame kept" Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,6,0,0" />
                <TextBlock Grid.Row="1" Grid.Column="2" Text="Last frame kept" Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,6,0,0" />
            </Grid>

            <!-- Timeline -->
            <StackPanel Grid.Row="2" Margin="14,14,14,0">
                <controls:RangeTimeline x:Name="Timeline" RangeChanged="OnRangeChanged" />
                <Grid Margin="10,0">
                    <TextBlock Text="0:00.0" Style="{StaticResource Caption}" FontSize="11" />
                    <TextBlock x:Name="DurationText" Style="{StaticResource Caption}" FontSize="11" HorizontalAlignment="Right" />
                </Grid>
            </StackPanel>

            <!-- Exact times -->
            <Grid Grid.Row="3" Margin="24,14,24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Start" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0" />
                <TextBox x:Name="StartBox" Grid.Column="1" FontFamily="Cascadia Mono, Consolas, Segoe UI" LostKeyboardFocus="OnTimeBoxCommit" KeyDown="OnTimeBoxKeyDown" />
                <TextBlock Grid.Column="3" Text="End" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0" />
                <TextBox x:Name="EndBox" Grid.Column="4" FontFamily="Cascadia Mono, Consolas, Segoe UI" LostKeyboardFocus="OnTimeBoxCommit" KeyDown="OnTimeBoxKeyDown" />
                <TextBlock x:Name="LengthText" Grid.Column="5" HorizontalAlignment="Right" VerticalAlignment="Center"
                           FontFamily="Cascadia Mono, Consolas, Segoe UI" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
            </Grid>

            <!-- Fast mode -->
            <Grid Grid.Row="4" Margin="24,16,24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Fast cut (no re-encoding)" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource Caption}" FontSize="11.5" TextWrapping="Wrap" Margin="0,2,0,0"
                               Text="Instant and keeps the original quality, but the cut snaps to the nearest keyframe, so the clip may start a little earlier than chosen." />
                </StackPanel>
                <CheckBox x:Name="FastCheck" Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center" Margin="16,0,0,0" />
            </Grid>

            <!-- Footer -->
            <Border Grid.Row="5" Background="{DynamicResource WindowBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0"
                    CornerRadius="0,0,12,12" Padding="24,14" Margin="0,18,0,0">
                <Grid>
                    <TextBlock Style="{StaticResource Caption}" VerticalAlignment="Center" FontSize="11.5" Margin="0,0,220,0" TextTrimming="CharacterEllipsis">
                        Drag the handles, slide the highlighted part, or type times like 1:05 or 65.5
                    </TextBlock>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel" IsCancel="True" Click="OnCancelClick" Margin="0,0,8,0" MinWidth="88" />
                        <Button x:Name="ConfirmButton" Style="{StaticResource AccentButton}" Content="Trim" IsDefault="True" Click="OnConfirmClick" MinWidth="88" IsEnabled="False" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
