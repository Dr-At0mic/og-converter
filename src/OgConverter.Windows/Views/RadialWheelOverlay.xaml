<Window x:Class="OgConverter.Views.RadialWheelOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:OgConverter.Controls"
        Title="OG Converter Overlay"
        Width="560" Height="620"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#01000000"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        WindowStartupLocation="Manual"
        FontFamily="{StaticResource UiFont}"
        TextOptions.TextFormattingMode="Display"
        AllowDrop="True"
        DragEnter="OnDragEnter"
        DragOver="OnDragOver"
        DragLeave="OnDragLeave"
        Drop="OnDrop">

    <Window.Resources>
        <!-- The wheel itself animates (template motion); the window only fades so the hint bar doesn't pop in -->
        <Storyboard x:Key="OpenAnimation">
            <DoubleAnimation Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="Opacity"
                             From="0.0" To="1.0" Duration="0:0:0.1" />
        </Storyboard>

        <!-- Colors come from the active template (set in code) -->
        <SolidColorBrush x:Key="HintBarBrush" Color="#F515171C" />
        <SolidColorBrush x:Key="HintEdgeBrush" Color="#30FFFFFF" />
        <SolidColorBrush x:Key="KeyCapBrush" Color="#1C1E24" />
        <SolidColorBrush x:Key="KeyCapEdgeBrush" Color="#3A3D46" />
        <SolidColorBrush x:Key="KeyTextBrush" Color="#A1A6B0" />
        <SolidColorBrush x:Key="HintLabelBrush" Color="#ECEDEF" />

        <Style x:Key="KeyCap" TargetType="Border">
            <Setter Property="BorderThickness" Value="1,1,1,1.5" />
            <Setter Property="BorderBrush" Value="{DynamicResource KeyCapEdgeBrush}" />
            <Setter Property="Background" Value="{DynamicResource KeyCapBrush}" />
            <Setter Property="CornerRadius" Value="3.5" />
            <Setter Property="Padding" Value="4,0,4,1" />
            <Setter Property="Margin" Value="0,0,5,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="KeyText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="9.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource KeyTextBrush}" />
        </Style>
        <Style x:Key="ModeLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Foreground" Value="{DynamicResource HintLabelBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="ModeSegment" TargetType="Border">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="5,3,7,3" />
            <Setter Property="Margin" Value="1,0" />
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid" AllowDrop="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <controls:RadialWheelCanvas x:Name="WheelCanvas" Grid.Row="0" Width="460" Height="460"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" AllowDrop="True" />

        <!-- Shortcut hints (Settings › Advanced can hide them); scales with the wheel -->
        <Border x:Name="HintBar" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Top"
                Background="{DynamicResource HintBarBrush}" BorderBrush="{DynamicResource HintEdgeBrush}" BorderThickness="1"
                CornerRadius="8" Padding="3">
            <Border.LayoutTransform>
                <ScaleTransform x:Name="HintScale" ScaleX="1" ScaleY="1" />
            </Border.LayoutTransform>
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="3" Direction="270" Opacity="0.35" Color="#000000" />
            </Border.Effect>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border x:Name="ConvertBadge" Style="{StaticResource ModeSegment}">
                    <StackPanel Orientation="Horizontal">
                        <Border x:Name="ConvertKeyCap" Style="{StaticResource KeyCap}">
                            <TextBlock x:Name="ConvertKeyText" Text="Shift" Style="{StaticResource KeyText}" />
                        </Border>
                        <TextBlock x:Name="ConvertLabel" Text="Convert" Style="{StaticResource ModeLabel}" />
                    </StackPanel>
                </Border>

                <Border x:Name="ToolsBadge" Style="{StaticResource ModeSegment}">
                    <StackPanel Orientation="Horizontal">
                        <Border x:Name="ToolsKeyCap" Style="{StaticResource KeyCap}">
                            <TextBlock x:Name="ToolsKeyText" Text="Ctrl" Style="{StaticResource KeyText}" />
                        </Border>
                        <TextBlock x:Name="ToolsLabel" Text="Tools" Style="{StaticResource ModeLabel}" />
                    </StackPanel>
                </Border>

                <Border x:Name="ActionsBadge" Style="{StaticResource ModeSegment}">
                    <StackPanel Orientation="Horizontal">
                        <Border x:Name="ActionsKeyCap" Style="{StaticResource KeyCap}">
                            <TextBlock x:Name="ActionsKeyText" Text="Alt" Style="{StaticResource KeyText}" />
                        </Border>
                        <TextBlock x:Name="ActionsLabel" Text="Actions" Style="{StaticResource ModeLabel}" />
                    </StackPanel>
                </Border>

                <Border Width="1" Height="13" Background="{DynamicResource HintEdgeBrush}" Margin="4,0" />

                <Border Style="{StaticResource ModeSegment}" Opacity="0.75">
                    <StackPanel Orientation="Horizontal">
                        <Border x:Name="CancelKeyCap" Style="{StaticResource KeyCap}">
                            <TextBlock x:Name="CancelKeyText" Text="Esc" Style="{StaticResource KeyText}" />
                        </Border>
                        <TextBlock x:Name="CancelLabel" Text="Cancel" Style="{StaticResource ModeLabel}" Foreground="{DynamicResource KeyTextBrush}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</Window>
