<Window x:Class="OgConverter.Views.ExtrasDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Recommended extras"
        Icon="pack://application:,,,/Assets/og-converter.ico"
        Width="520" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        Foreground="{DynamicResource TextPrimaryBrush}"
        TextOptions.TextFormattingMode="Display">

    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderStrongBrush}"
            BorderThickness="1" CornerRadius="12" Margin="16" Effect="{StaticResource FlyoutShadow}">
        <StackPanel>
            <!-- Header (drag to move) -->
            <Grid MouseLeftButtonDown="OnHeaderMouseDown" Background="Transparent" Margin="24,22,24,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="36" Height="36" CornerRadius="8" Background="{DynamicResource AccentSubtleBrush}" Margin="0,0,14,0" VerticalAlignment="Top">
                    <TextBlock Text="&#xE896;" Style="{StaticResource Icon}" Foreground="{DynamicResource AccentBrush}" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Recommended extras" Style="{StaticResource H2}" />
                    <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0"
                               Text="Free helpers that unlock more formats. Pick what you want; you can always add them later in Settings › Engine." />
                </StackPanel>
            </Grid>

            <StackPanel Margin="24,0,24,0">
                <!-- FFmpeg -->
                <Border x:Name="FFmpegRow" Background="{DynamicResource InputBrush}" CornerRadius="8" Padding="14,12" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <CheckBox x:Name="FFmpegCheck" IsChecked="True" VerticalAlignment="Top" Margin="0,1,10,0" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="FFmpeg" FontWeight="SemiBold" />
                            <TextBlock x:Name="FFmpegDesc" Style="{StaticResource Caption}" Margin="0,2,0,0"
                                       Text="Video, audio, GIF, WebP and AVIF conversion and compression, plus video crop and trim. No admin rights needed." />
                            <TextBlock x:Name="FFmpegStatus" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- LibreOffice -->
                <Border x:Name="LibreOfficeRow" Background="{DynamicResource InputBrush}" CornerRadius="8" Padding="14,12" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <CheckBox x:Name="LibreOfficeCheck" IsChecked="True" VerticalAlignment="Top" Margin="0,1,10,0" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="LibreOffice (free office suite)" FontWeight="SemiBold" />
                            <TextBlock x:Name="LibreOfficeDesc" Style="{StaticResource Caption}" Margin="0,2,0,0"
                                       Text="Neither Microsoft Office nor LibreOffice was found. LibreOffice is free, works offline and opens Word, Excel and PowerPoint files. About 350 MB; Windows asks for admin permission once." />
                            <TextBlock Style="{StaticResource Caption}" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,6,0,0"
                                       Text="Prefer Microsoft Office? It isn't free, but if you install it, OG Converter uses it automatically." />
                            <TextBlock x:Name="LibreOfficeStatus" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBlock x:Name="FooterNote" Style="{StaticResource Caption}" Foreground="{DynamicResource TextTertiaryBrush}" Margin="2,2,0,0"
                           Text="Installed with winget from the official packages. Nothing is installed unless you click Install." />
            </StackPanel>

            <!-- Footer -->
            <Border Background="{DynamicResource WindowBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0"
                    CornerRadius="0,0,12,12" Padding="24,14" Margin="0,18,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CancelButton" Content="Not now" IsCancel="True" Click="OnCancelClick" Margin="0,0,8,0" MinWidth="88" />
                    <Button x:Name="ConfirmButton" Style="{StaticResource AccentButton}" Content="Install selected" IsDefault="True" Click="OnConfirmClick" MinWidth="120" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</Window>
