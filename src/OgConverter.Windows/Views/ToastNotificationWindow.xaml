<Window x:Class="OgConverter.Views.ToastNotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Notification"
        Width="440" Height="112"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        WindowStartupLocation="Manual"
        FontFamily="{StaticResource UiFont}"
        TextOptions.TextFormattingMode="Display">

    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1"
            CornerRadius="10" Margin="12" Padding="14,12" Effect="{StaticResource FlyoutShadow}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Status -->
            <Border x:Name="StatusBg" Grid.Column="0" Width="34" Height="34" CornerRadius="17" Background="{DynamicResource SuccessSubtleBrush}"
                    VerticalAlignment="Center" Margin="0,0,12,0">
                <TextBlock x:Name="StatusIcon" Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="14" Foreground="{DynamicResource SuccessBrush}" />
            </Border>

            <!-- Details -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="TitleText" Text="Done" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="SubtitleText" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                <TextBlock x:Name="MetricsText" FontSize="11.5" Foreground="{DynamicResource TextTertiaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                <!-- Progress (long-running jobs only) -->
                <Grid x:Name="ProgressTrack" Height="3" Margin="0,7,0,0" Visibility="Collapsed" ClipToBounds="True">
                    <Border Background="{DynamicResource BorderStrongBrush}" CornerRadius="1.5" />
                    <!-- Sweep until the first percentage arrives (some work can't be measured) -->
                    <Border x:Name="ProgressSweep" CornerRadius="1.5" Visibility="Collapsed">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <LinearGradientBrush.RelativeTransform>
                                    <TranslateTransform x:Name="SweepShift" X="-1" />
                                </LinearGradientBrush.RelativeTransform>
                                <GradientStop Color="Transparent" Offset="0.2" />
                                <GradientStop Color="{DynamicResource AccentColor}" Offset="0.5" />
                                <GradientStop Color="Transparent" Offset="0.8" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <Border x:Name="ProgressFill" Background="{DynamicResource ModeToolsBrush}" CornerRadius="1.5" RenderTransformOrigin="0,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="ProgressScale" ScaleX="0" />
                        </Border.RenderTransform>
                    </Border>
                </Grid>
            </StackPanel>

            <!-- Actions -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                <Button x:Name="CancelBtn" Content="Cancel" Click="OnCancelClick" Padding="12,4" FontSize="12" Margin="0,0,4,0" Visibility="Collapsed" />
                <Button x:Name="OpenFileBtn" Style="{StaticResource AccentButton}" Content="Open" Click="OnOpenFileClick" Padding="12,4" FontSize="12" Margin="0,0,4,0" />
                <Button Style="{StaticResource IconButton}" Content="&#xE8BB;" Click="OnCloseClick" Width="26" Height="26" FontSize="10" ToolTip="Dismiss" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
