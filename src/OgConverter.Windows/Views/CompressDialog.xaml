<Window x:Class="OgConverter.Views.CompressDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Compress"
        Icon="pack://application:,,,/Assets/og-converter.ico"
        Width="600" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" Topmost="True" ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        Foreground="{DynamicResource TextPrimaryBrush}"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <!-- Lossless / Lossy card -->
        <Style x:Key="ModeCard" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="14,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid Width="18" Height="18" VerticalAlignment="Top" Margin="0,1,12,0">
                                    <Ellipse x:Name="ring" Stroke="{DynamicResource BorderStrongBrush}" StrokeThickness="1" Fill="{DynamicResource SurfaceBrush}" />
                                    <Ellipse x:Name="dot" Width="8" Height="8" Fill="{DynamicResource OnAccentBrush}" Visibility="Collapsed" />
                                </Grid>
                                <ContentPresenter Grid.Column="1" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource TextTertiaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentFaintBrush}" />
                                <Setter TargetName="ring" Property="Fill" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="ring" Property="Stroke" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="dot" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Preset chip -->
        <Style x:Key="PresetChip" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" CornerRadius="14" Padding="12,5">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource TextTertiaryBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderStrongBrush}"
            BorderThickness="1" CornerRadius="12" Margin="16" Effect="{StaticResource FlyoutShadow}">
        <StackPanel>
            <!-- Header (drag to move) -->
            <Grid MouseLeftButtonDown="OnHeaderMouseDown" Background="Transparent" Margin="24,22,24,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="36" Height="36" CornerRadius="8" Background="{DynamicResource ModeToolsSubtleBrush}" Margin="0,0,14,0" VerticalAlignment="Top">
                    <TextBlock Text="&#xE73F;" Style="{StaticResource Icon}" Foreground="{DynamicResource ModeToolsBrush}" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="HeaderText" Text="Compress" Style="{StaticResource H2}" />
                    <TextBlock x:Name="FileInfoText" Style="{StaticResource Caption}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                </StackPanel>
            </Grid>

            <ScrollViewer x:Name="BodyScroller" MaxHeight="640" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="24,0,24,0">
                    <!-- Mode -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <RadioButton x:Name="LosslessCard" Style="{StaticResource ModeCard}" GroupName="Mode" Checked="OnModeChanged">
                            <StackPanel>
                                <TextBlock Text="Lossless" FontWeight="SemiBold" />
                                <TextBlock x:Name="LosslessHint" Style="{StaticResource Caption}" FontSize="11.5" TextWrapping="Wrap" Margin="0,3,0,0"
                                           Text="Identical quality. Smaller where the format allows." />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="LossyCard" Grid.Column="2" Style="{StaticResource ModeCard}" GroupName="Mode" Checked="OnModeChanged">
                            <StackPanel>
                                <TextBlock Text="Lossy" FontWeight="SemiBold" />
                                <TextBlock x:Name="LossyHint" Style="{StaticResource Caption}" FontSize="11.5" TextWrapping="Wrap" Margin="0,3,0,0"
                                           Text="Much smaller files. You choose the quality." />
                            </StackPanel>
                        </RadioButton>
                    </Grid>

                    <!-- Presets -->
                    <StackPanel x:Name="PresetSection" Margin="0,18,0,0">
                        <TextBlock Text="Preset" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <WrapPanel x:Name="PresetPanel" />
                    </StackPanel>

                    <!-- Settings for this file kind and mode (built in code) -->
                    <Border Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="16,14" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="SETTINGS" Style="{StaticResource Overline}" Margin="0,0,0,12" />
                            <StackPanel x:Name="SettingsPanel" />
                        </StackPanel>
                    </Border>

                    <!-- Summary -->
                    <Border Background="{DynamicResource InputBrush}" CornerRadius="6" Padding="12,10" Margin="0,14,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="SummaryIcon" Text="&#xE946;" Style="{StaticResource Icon}" FontSize="12" Margin="0,1,8,0" VerticalAlignment="Top"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <StackPanel Grid.Column="1">
                                <TextBlock x:Name="SummaryText" FontSize="12" TextWrapping="Wrap" />
                                <TextBlock x:Name="WarningText" FontSize="11.5" TextWrapping="Wrap" Margin="0,4,0,0"
                                           Foreground="{DynamicResource WarningBrush}" Visibility="Collapsed" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Footer -->
            <Border Background="{DynamicResource WindowBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0"
                    CornerRadius="0,0,12,12" Padding="24,14" Margin="0,20,0,0">
                <Grid>
                    <Button x:Name="ResetButton" Style="{StaticResource GhostButton}" Content="Reset to defaults" HorizontalAlignment="Left"
                            FontSize="12" Padding="10,5" Click="OnResetClick" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel" IsCancel="True" Click="OnCancelClick" Margin="0,0,8,0" MinWidth="88" />
                        <Button x:Name="ConfirmButton" Style="{StaticResource AccentButton}" Content="Compress" IsDefault="True" Click="OnConfirmClick" MinWidth="88" />
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </Border>
</Window>
