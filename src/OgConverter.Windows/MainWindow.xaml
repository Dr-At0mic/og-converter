<Window x:Class="OgConverter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:OgConverter.Controls"
        Title="OG Converter"
        Icon="pack://application:,,,/Assets/og-converter.ico"
        Width="1080" Height="720"
        MinWidth="900" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{StaticResource UiFont}"
        FontSize="13"
        TextOptions.TextFormattingMode="Display">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- One row in a settings group: icon, title + description, control on the right -->
        <Style x:Key="SettingRow" TargetType="Grid">
            <Setter Property="Margin" Value="18,14" />
            <Setter Property="MinHeight" Value="36" />
        </Style>
        <Style x:Key="RowDivider" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="{DynamicResource DividerBrush}" />
        </Style>
        <Style x:Key="FormatChip" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="Margin" Value="3" />
        </Style>
        <Style x:Key="KeyCap" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
            <Setter Property="BorderThickness" Value="1,1,1,2" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
        </Style>
    </Window.Resources>

    <Grid Background="{DynamicResource WindowBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============================ Title bar ============================ -->
        <Border Grid.Row="0" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Brand -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Border Width="22" Height="22" CornerRadius="6" Margin="0,0,10,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="{DynamicResource BrandStartColor}" Offset="0" />
                                <GradientStop Color="{DynamicResource BrandEndColor}" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="OG" Foreground="{DynamicResource OnAccentBrush}" FontWeight="Bold" FontSize="9.5" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="OG Converter" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Navigation -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton x:Name="TabOverview" Style="{StaticResource NavTab}" Content="Home" Tag="&#xE80F;" IsChecked="True"
                                 Checked="OnTabNavChanged" WindowChrome.IsHitTestVisibleInChrome="True" />
                    <RadioButton x:Name="TabSettings" Style="{StaticResource NavTab}" Content="Settings" Tag="&#xE713;"
                                 Checked="OnTabNavChanged" WindowChrome.IsHitTestVisibleInChrome="True" />
                    <RadioButton x:Name="TabAbout" Style="{StaticResource NavTab}" Content="About" Tag="&#xE946;"
                                 Checked="OnTabNavChanged" WindowChrome.IsHitTestVisibleInChrome="True" />
                </StackPanel>

                <!-- Utilities + window controls -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Button Style="{StaticResource IconButton}" Content="&#xE768;" Click="OnTestWheelClick" ToolTip="Preview the wheel"
                            WindowChrome.IsHitTestVisibleInChrome="True" Margin="0,7,2,0" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE8A0;" Click="OnMinimizeToTrayClick" ToolTip="Hide to system tray (keeps running)"
                            WindowChrome.IsHitTestVisibleInChrome="True" Margin="0,7,10,0" />
                    <Border Width="1" Height="18" Background="{DynamicResource BorderBrush}" VerticalAlignment="Top" Margin="0,13,4,0" />
                    <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="OnMinimizeWindowClick" ToolTip="Minimize"
                            WindowChrome.IsHitTestVisibleInChrome="True" />
                    <Button x:Name="MaximizeBtn" Style="{StaticResource CaptionButton}" Content="&#xE922;" Click="OnMaximizeWindowClick" ToolTip="Maximize"
                            WindowChrome.IsHitTestVisibleInChrome="True" />
                    <Button Style="{StaticResource CaptionCloseButton}" Content="&#xE8BB;" Click="OnCloseWindowClick" ToolTip="Close"
                            WindowChrome.IsHitTestVisibleInChrome="True" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================ Content ============================ -->
        <Grid Grid.Row="1">

            <!-- ======================= HOME ======================= -->
            <Grid x:Name="ViewOverview" Margin="28,24,28,28" Visibility="Visible">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Page header -->
                <Grid Grid.Row="0" Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Home" Style="{StaticResource H1}" />
                        <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0"
                                   Text="Start dragging any file in Explorer, then tap a shortcut key to open the wheel." />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="16,4,0,0">
                        <Border x:Name="KeyMappingNotice" Visibility="Collapsed" Background="{DynamicResource WarningSubtleBrush}"
                                CornerRadius="12" Padding="10,4" Margin="0,0,8,0" MaxWidth="380">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" FontSize="12" Foreground="{DynamicResource WarningBrush}" Margin="0,0,6,0" />
                                <TextBlock x:Name="KeyMappingNoticeText" Foreground="{DynamicResource WarningBrush}" FontSize="11.5" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>
                        <ComboBox x:Name="TemplateQuickCombo" Width="148" Margin="0,0,10,0" VerticalAlignment="Center"
                                  SelectionChanged="OnQuickTemplateChanged" ToolTip="Wheel template: changes the wheel and the app's colors" />
                        <Border Background="{DynamicResource SuccessSubtleBrush}" CornerRadius="12" Padding="10,4" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Fill="{DynamicResource SuccessBrush}" VerticalAlignment="Center" Margin="0,0,7,0" />
                                <TextBlock Text="Listening for shortcuts" Foreground="{DynamicResource SuccessBrush}" FontSize="11.5" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Running portable: offer to install -->
                <Border x:Name="InstallBanner" Grid.Row="1" Visibility="Collapsed" Background="{DynamicResource AccentFaintBrush}"
                        BorderBrush="{DynamicResource AccentSubtleBrush}" BorderThickness="1" CornerRadius="{DynamicResource CardRadius}"
                        Padding="14,10,8,10" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE896;" Style="{StaticResource Icon}" Foreground="{DynamicResource AccentBrush}" Margin="0,0,12,0" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Running without installing" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource Caption}" Margin="0,2,12,0"
                                       Text="Install to add OG Converter to Start and have it waiting in the tray every time you sign in. No admin rights needed." />
                        </StackPanel>
                        <Button Grid.Column="2" Style="{StaticResource AccentButton}" Content="Install" Click="OnInstallBannerClick" Padding="16,6" VerticalAlignment="Center" />
                        <Button Grid.Column="3" Style="{StaticResource IconButton}" Content="&#xE711;" Click="OnDismissInstallBannerClick"
                                ToolTip="Don't show again (you can install from Settings › System)" Width="30" Height="30" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- Shortcut cards -->
                <Grid Grid.Row="2" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Card}" Padding="16,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="36" Height="36" CornerRadius="8" Background="{DynamicResource ModeConvertSubtleBrush}" Margin="0,0,12,0">
                                <TextBlock Text="&#xE8AB;" Style="{StaticResource Icon}" Foreground="{DynamicResource ModeConvertBrush}" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Convert" FontWeight="SemiBold" />
                                <TextBlock Text="Change file format" Style="{StaticResource Caption}" FontSize="11.5" Margin="0,1,0,0" />
                            </StackPanel>
                            <ComboBox x:Name="ConvertKeyCombo" Grid.Column="2" Width="96" VerticalAlignment="Center" SelectionChanged="OnKeyMappingChanged" ToolTip="Key that opens the Convert wheel">
                                <ComboBoxItem Content="Shift" IsSelected="True" />
                                <ComboBoxItem Content="Control" />
                                <ComboBoxItem Content="Alt" />
                                <ComboBoxItem Content="Win" />
                                <ComboBoxItem Content="Space" />
                            </ComboBox>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="36" Height="36" CornerRadius="8" Background="{DynamicResource ModeToolsSubtleBrush}" Margin="0,0,12,0">
                                <TextBlock Text="&#xE90F;" Style="{StaticResource Icon}" Foreground="{DynamicResource ModeToolsBrush}" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Tools" FontWeight="SemiBold" />
                                <TextBlock Text="Compress, split, edit" Style="{StaticResource Caption}" FontSize="11.5" Margin="0,1,0,0" />
                            </StackPanel>
                            <ComboBox x:Name="ToolsKeyCombo" Grid.Column="2" Width="96" VerticalAlignment="Center" SelectionChanged="OnKeyMappingChanged" ToolTip="Key that opens the Tools wheel">
                                <ComboBoxItem Content="Control" IsSelected="True" />
                                <ComboBoxItem Content="Shift" />
                                <ComboBoxItem Content="Alt" />
                                <ComboBoxItem Content="Win" />
                                <ComboBoxItem Content="Space" />
                            </ComboBox>
                        </Grid>
                    </Border>

                    <Border Grid.Column="4" Style="{StaticResource Card}" Padding="16,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="36" Height="36" CornerRadius="8" Background="{DynamicResource ModeActionsSubtleBrush}" Margin="0,0,12,0">
                                <TextBlock Text="&#xE945;" Style="{StaticResource Icon}" Foreground="{DynamicResource ModeActionsBrush}" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Actions" FontWeight="SemiBold" />
                                <TextBlock Text="Path, terminal, hash" Style="{StaticResource Caption}" FontSize="11.5" Margin="0,1,0,0" />
                            </StackPanel>
                            <ComboBox x:Name="ActionsKeyCombo" Grid.Column="2" Width="96" VerticalAlignment="Center" SelectionChanged="OnKeyMappingChanged" ToolTip="Key that opens the Actions wheel">
                                <ComboBoxItem Content="Alt" IsSelected="True" />
                                <ComboBoxItem Content="Control" />
                                <ComboBoxItem Content="Shift" />
                                <ComboBoxItem Content="Win" />
                                <ComboBoxItem Content="Space" />
                            </ComboBox>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Studio + activity -->
                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.25*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" MinWidth="300" />
                    </Grid.ColumnDefinitions>

                    <!-- Try it -->
                    <Border Grid.Column="0" Style="{StaticResource Card}" AllowDrop="True"
                            DragEnter="OnPlaygroundDragEnter" DragOver="OnPlaygroundDragOver"
                            DragLeave="OnPlaygroundDragLeave" Drop="OnPlaygroundDrop">
                        <Grid Margin="20,18,20,20">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Margin="0,0,0,14">
                                <TextBlock Text="Try it here" Style="{StaticResource H2}" />
                                <TextBlock Text="Drop a file to preview its wheel and run a conversion." Style="{StaticResource Caption}" Margin="0,3,0,0" />
                            </StackPanel>

                            <!-- Empty: dashed drop zone -->
                            <Grid x:Name="PlaygroundPrompt" Grid.Row="1">
                                <Rectangle RadiusX="8" RadiusY="8" Stroke="{DynamicResource BorderStrongBrush}" StrokeThickness="1.2"
                                           StrokeDashArray="5 4" Fill="{DynamicResource DropZoneBrush}" />
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="16">
                                    <Border Width="52" Height="52" CornerRadius="26" Background="{DynamicResource SurfaceRaisedBrush}" HorizontalAlignment="Center">
                                        <TextBlock Text="&#xE898;" Style="{StaticResource Icon}" FontSize="22" Foreground="{DynamicResource AccentBrush}" />
                                    </Border>
                                    <TextBlock Text="Drop a file here" FontWeight="SemiBold" FontSize="14" HorizontalAlignment="Center" Margin="0,14,0,4" />
                                    <TextBlock Text="Images, video, audio, PDF and archives" Style="{StaticResource Caption}" HorizontalAlignment="Center" />
                                    <Button Style="{StaticResource AccentButton}" Click="OnChooseFileClick" HorizontalAlignment="Center" Margin="0,16,0,0" Padding="16,7">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE8E5;" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <TextBlock Text="Browse files" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!-- Loaded: interactive wheel -->
                            <Grid x:Name="PlaygroundWheelContainer" Grid.Row="1" Visibility="Collapsed">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <!-- Preview always fills the panel; the Size setting only affects the on-screen overlay -->
                                <Viewbox Grid.Row="0" Stretch="Uniform">
                                    <controls:RadialWheelCanvas x:Name="PlaygroundWheel" Width="460" Height="460" />
                                </Viewbox>
                                <Grid Grid.Row="1" Margin="0,10,0,0">
                                    <TextBlock x:Name="PlaygroundInstructions" Style="{StaticResource Caption}" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,0,90,0" />
                                    <Button Content="Close" Click="OnCancelPlaygroundWheel" HorizontalAlignment="Right" Padding="12,5" />
                                </Grid>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Recent activity -->
                    <Border Grid.Column="2" Style="{StaticResource Card}">
                        <Grid Margin="0,18,0,8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="20,0,14,10">
                                <TextBlock Text="Recent activity" Style="{StaticResource H2}" VerticalAlignment="Center" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button x:Name="CancelAllButton" Style="{StaticResource GhostButton}" Content="Cancel all" Click="OnCancelAllClick" FontSize="12"
                                            ToolTip="Stop every job that's waiting or running" Visibility="Collapsed" Margin="0,0,4,0" />
                                    <Button Style="{StaticResource GhostButton}" Content="Clear" Click="OnClearHistoryClick" FontSize="12" />
                                </StackPanel>
                            </Grid>

                            <ListBox x:Name="HistoryList" Grid.Row="1" Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="0" Padding="8,0"
                                     ItemContainerStyle="{StaticResource PlainListItem}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="row" CornerRadius="8" Padding="12,10" Margin="0,0,0,2" Background="Transparent">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <Border x:Name="statusBg" Width="30" Height="30" CornerRadius="15" Background="{DynamicResource SuccessSubtleBrush}" VerticalAlignment="Top" Margin="0,1,12,0">
                                                    <TextBlock x:Name="statusIcon" Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="12" Foreground="{DynamicResource SuccessBrush}" />
                                                </Border>

                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding SourceFileName}" FontWeight="SemiBold" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                        <Border Background="{DynamicResource SurfaceRaisedBrush}" CornerRadius="3" Padding="5,0" Margin="0,0,6,0">
                                                            <TextBlock Text="{Binding TargetFormat}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                        </Border>
                                                        <TextBlock x:Name="detail" Text="{Binding DetailText}" ToolTip="{Binding ResultText}" FontSize="11.5" Foreground="{DynamicResource TextTertiaryBrush}" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <TextBlock x:Name="error" Text="{Binding ErrorMessage}" FontSize="11.5" Foreground="{DynamicResource DangerBrush}"
                                                               TextWrapping="Wrap" Margin="0,3,0,0" Visibility="Collapsed" MaxHeight="48" />
                                                    <!-- Running: percentage bar, or a sweep while the work can't be measured -->
                                                    <Grid x:Name="progressPanel" Margin="0,6,0,0" Visibility="Collapsed">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="64" />
                                                        </Grid.ColumnDefinitions>
                                                        <Grid Height="3" VerticalAlignment="Center" ClipToBounds="True">
                                                            <Border Background="{DynamicResource BorderStrongBrush}" CornerRadius="1.5" />
                                                            <Border x:Name="progressFill" Background="{DynamicResource AccentBrush}" CornerRadius="1.5" RenderTransformOrigin="0,0.5">
                                                                <Border.RenderTransform>
                                                                    <ScaleTransform ScaleX="{Binding Progress}" />
                                                                </Border.RenderTransform>
                                                            </Border>
                                                            <Border x:Name="progressSweep" CornerRadius="1.5" Visibility="Collapsed">
                                                                <Border.Background>
                                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                                        <LinearGradientBrush.RelativeTransform>
                                                                            <TranslateTransform X="-1" />
                                                                        </LinearGradientBrush.RelativeTransform>
                                                                        <GradientStop Color="Transparent" Offset="0.2" />
                                                                        <GradientStop Color="{DynamicResource AccentColor}" Offset="0.5" />
                                                                        <GradientStop Color="Transparent" Offset="0.8" />
                                                                    </LinearGradientBrush>
                                                                </Border.Background>
                                                            </Border>
                                                        </Grid>
                                                        <TextBlock Grid.Column="1" Text="{Binding ProgressText}" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}"
                                                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                    </Grid>
                                                </StackPanel>

                                                <StackPanel x:Name="rowActions" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0" Opacity="0.55">
                                                    <Button Style="{StaticResource IconButton}" Content="&#xE8A7;" Tag="{Binding TargetPath}" Click="OnOpenHistoryFileClick" ToolTip="Open" Width="28" Height="28" FontSize="12" />
                                                    <Button Style="{StaticResource IconButton}" Content="&#xE838;" Tag="{Binding TargetPath}" Click="OnOpenHistoryFolderClick" ToolTip="Show in Explorer" Width="28" Height="28" FontSize="12" />
                                                </StackPanel>
                                                <Button x:Name="rowCancel" Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE711;" Tag="{Binding}" Click="OnCancelHistoryJobClick"
                                                        ToolTip="Cancel" Width="28" Height="28" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0" Visibility="Collapsed" />
                                            </Grid>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsSuccess}" Value="False">
                                                <Setter TargetName="statusBg" Property="Background" Value="{DynamicResource DangerSubtleBrush}" />
                                                <Setter TargetName="statusIcon" Property="Text" Value="&#xE711;" />
                                                <Setter TargetName="statusIcon" Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                <Setter TargetName="error" Property="Visibility" Value="Visible" />
                                                <Setter TargetName="detail" Property="Visibility" Value="Collapsed" />
                                                <Setter TargetName="rowActions" Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <!-- After the IsSuccess trigger so it wins while the job is still running -->
                                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                <Setter TargetName="statusBg" Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
                                                <Setter TargetName="statusIcon" Property="Text" Value="&#xE895;" />
                                                <Setter TargetName="statusIcon" Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                <Setter TargetName="error" Property="Visibility" Value="Collapsed" />
                                                <Setter TargetName="detail" Property="Visibility" Value="Collapsed" />
                                                <Setter TargetName="rowActions" Property="Visibility" Value="Collapsed" />
                                                <Setter TargetName="rowCancel" Property="Visibility" Value="Visible" />
                                                <Setter TargetName="progressPanel" Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsRunning}" Value="True" />
                                                    <Condition Binding="{Binding HasProgress}" Value="False" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter TargetName="progressFill" Property="Visibility" Value="Collapsed" />
                                                <Setter TargetName="progressSweep" Property="Visibility" Value="Visible" />
                                                <MultiDataTrigger.EnterActions>
                                                    <BeginStoryboard x:Name="sweep">
                                                        <Storyboard RepeatBehavior="Forever">
                                                            <DoubleAnimation Storyboard.TargetName="progressSweep"
                                                                             Storyboard.TargetProperty="(Border.Background).(Brush.RelativeTransform).(TranslateTransform.X)"
                                                                             From="-1" To="1" Duration="0:0:1.4" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </MultiDataTrigger.EnterActions>
                                                <MultiDataTrigger.ExitActions>
                                                    <StopStoryboard BeginStoryboardName="sweep" />
                                                </MultiDataTrigger.ExitActions>
                                            </MultiDataTrigger>
                                            <!-- Waiting for a queue slot: an empty bar, not the "working" sweep -->
                                            <DataTrigger Binding="{Binding IsQueued}" Value="True">
                                                <Setter TargetName="progressSweep" Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="row" Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
                                                <Setter TargetName="rowActions" Property="Opacity" Value="1" />
                                            </Trigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <StackPanel x:Name="EmptyHistoryNotice" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24">
                                <TextBlock Text="&#xE81C;" Style="{StaticResource Icon}" FontSize="26" Foreground="{DynamicResource TextTertiaryBrush}" />
                                <TextBlock Text="No activity yet" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,4" />
                                <TextBlock Style="{StaticResource Caption}" TextAlignment="Center" HorizontalAlignment="Center">
                                    Drag a file and press <Run x:Name="EmptyHistoryKeyRun" Text="Shift" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" /> to get started.
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- ======================= SETTINGS ======================= -->
            <ScrollViewer x:Name="ViewSettings" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel MaxWidth="860" Margin="28,24,28,32">
                    <TextBlock Text="Settings" Style="{StaticResource H1}" />
                    <TextBlock Text="Changes are saved automatically." Style="{StaticResource Caption}" Margin="0,4,0,24" />

                    <!-- Appearance: wheel templates -->
                    <Grid Margin="2,0,0,8">
                        <TextBlock Text="Wheel templates" Style="{StaticResource SectionLabel}" Margin="0" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource GhostButton}" Click="OnOpenTemplatesFolderClick" FontSize="12" ToolTip="Open the folder community templates are installed in">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE838;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock Text="Folder" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource GhostButton}" Click="OnReloadTemplatesClick" FontSize="12" ToolTip="Rescan the templates folder">
                                <StackPanel Orientation="Horizontal">
