                                    <TextBlock Text="Export" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Click="OnAddTemplateClick" Margin="8,0,0,0" ToolTip="Locate a template.json, a .zip / .ogtemplate package, or a plugin .dll">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" Margin="0,0,7,0" />
                                    <TextBlock Text="Add template…" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                    <Border x:Name="TemplateGalleryCard" Style="{StaticResource Card}" Margin="0,0,0,24" Padding="12,12,4,8" AllowDrop="True"
