                                </StackPanel>
                            </Grid>
                            <Border Style="{StaticResource RowDivider}" />
                            <Grid Style="{StaticResource SettingRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE895;" Style="{StaticResource Icon}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,2,0,0" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="UpdateTitleText" Text="Updates" FontWeight="SemiBold" />
                                    <TextBlock x:Name="UpdateStatusText" Style="{StaticResource Caption}" Margin="0,2,24,0" TextWrapping="Wrap" />
                                    <ProgressBar x:Name="UpdateProgress" Visibility="Collapsed" Height="4" Margin="0,10,24,0" Minimum="0" Maximum="1"
                                                 BorderThickness="0" Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource SurfaceRaisedBrush}" />
                                    <Border x:Name="UpdateNotesPanel" Visibility="Collapsed" Margin="0,12,24,0" Padding="14,12"
                                            Background="{DynamicResource AccentFaintBrush}" CornerRadius="{DynamicResource ControlRadius}">
                                        <StackPanel>
                                            <TextBlock x:Name="UpdateNotesTitle" Style="{StaticResource Overline}" Margin="0,0,0,8" />
                                            <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                                <TextBlock x:Name="UpdateNotesText" Style="{StaticResource Caption}" FontSize="13" LineHeight="20" TextWrapping="Wrap" />
                                            </ScrollViewer>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                                    <Button x:Name="UpdateReleasePageButton" Style="{StaticResource GhostButton}" Content="Release page" Click="OnUpdateReleasePageClick"
                                            Margin="0,0,8,0" Visibility="Collapsed" />
                                    <Button x:Name="UpdateButton" Style="{StaticResource AccentButton}" Content="Check for updates" Click="OnUpdateClick" Padding="16,7" />
                                </StackPanel>
                            </Grid>
                            <Border Style="{StaticResource RowDivider}" />
                            <Grid Style="{StaticResource SettingRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE7E8;" Style="{StaticResource Icon}" HorizontalAlignment="Left" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Start with Windows" FontWeight="SemiBold" />
                                    <TextBlock x:Name="StartupDescText" Text="Opens quietly in the system tray when you sign in, so the wheel is always ready" Style="{StaticResource Caption}" Margin="0,2,24,0" />
                                </StackPanel>
                                <CheckBox x:Name="StartWithWindowsCheck" Grid.Column="2" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                          Checked="OnStartWithWindowsChanged" Unchecked="OnStartWithWindowsChanged" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Advanced -->
                    <TextBlock Text="Advanced" Style="{StaticResource SectionLabel}" />
                    <Border Style="{StaticResource Card}" Margin="0,0,0,24">
                        <StackPanel>
                            <Grid Style="{StaticResource SettingRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE92E;" Style="{StaticResource Icon}" HorizontalAlignment="Left" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Shortcut hints under the wheel" FontWeight="SemiBold" />
                                    <TextBlock Text="The Shift · Ctrl · Alt · Esc bar. Turn it off once you know the keys for a cleaner, smaller wheel." Style="{StaticResource Caption}" Margin="0,2,24,0" />
                                </StackPanel>
                                <CheckBox x:Name="ShowKeyHintsCheck" Grid.Column="2" Style="{StaticResource ToggleSwitch}" IsChecked="False" VerticalAlignment="Center"
                                          Checked="OnSettingChanged" Unchecked="OnSettingChanged" />
                            </Grid>
                            <Border Style="{StaticResource RowDivider}" />
                            <Grid Style="{StaticResource SettingRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE916;" Style="{StaticResource Icon}" HorizontalAlignment="Left" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Reduce motion" FontWeight="SemiBold" />
                                    <TextBlock Text="Show the wheel instantly, without open, switch and hover animations" Style="{StaticResource Caption}" Margin="0,2,24,0" />
                                </StackPanel>
                                <CheckBox x:Name="ReduceMotionCheck" Grid.Column="2" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                          Checked="OnSettingChanged" Unchecked="OnSettingChanged" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Engine -->
                    <TextBlock Text="Engine" Style="{StaticResource SectionLabel}" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid Style="{StaticResource SettingRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE714;" Style="{StaticResource Icon}" HorizontalAlignment="Left" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="FFmpeg" FontWeight="SemiBold" />
                                    <TextBlock x:Name="FFmpegPathText" Text="Optional. Used for video, audio, GIF, WebP, AVIF and JPEG XL" Style="{StaticResource Caption}" Margin="0,2,24,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="InstallFFmpegButton" Style="{StaticResource AccentButton}" Content="Install" Click="OnInstallFFmpegClick"
                                            Margin="0,0,10,0" Visibility="Collapsed" ToolTip="Installs FFmpeg with winget (free, no admin rights needed)" />
                                    <Border x:Name="FFmpegBadge" CornerRadius="12" Padding="10,4" VerticalAlignment="Center" BorderThickness="0">
                                        <TextBlock x:Name="FFmpegStatusText" Text="Checking…" FontSize="11.5" FontWeight="SemiBold" />
                                    </Border>
                                </StackPanel>
                            </Grid>
                            <Border Style="{StaticResource RowDivider}" />
                            <Grid Style="{StaticResource SettingRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE8F1;" Style="{StaticResource Icon}" HorizontalAlignment="Left" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Office documents" FontWeight="SemiBold" />
                                    <TextBlock x:Name="DocEngineText" Text="Optional. Word, Excel and PowerPoint formats, plus OpenDocument" Style="{StaticResource Caption}" Margin="0,2,24,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="InstallLibreOfficeButton" Style="{StaticResource AccentButton}" Content="Install LibreOffice (free)" Click="OnInstallLibreOfficeClick"
                                            Margin="0,0,10,0" Visibility="Collapsed" ToolTip="Free and opens Microsoft Office files. Installs with winget; Windows asks for admin permission once." />
                                    <Border x:Name="DocEngineBadge" CornerRadius="12" Padding="10,4" VerticalAlignment="Center">
                                        <TextBlock x:Name="DocEngineStatusText" Text="Checking…" FontSize="11.5" FontWeight="SemiBold" />
                                    </Border>
                                </StackPanel>
                            </Grid>
                            <Border Style="{StaticResource RowDivider}" />
                            <Grid Style="{StaticResource SettingRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE774;" Style="{StaticResource Icon}" HorizontalAlignment="Left" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Web browser" FontWeight="SemiBold" />
                                    <TextBlock x:Name="BrowserEngineText" Text="Markdown, web pages and SVG. Edge comes with Windows." Style="{StaticResource Caption}" Margin="0,2,24,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                </StackPanel>
                                <Border x:Name="BrowserBadge" Grid.Column="2" CornerRadius="12" Padding="10,4" VerticalAlignment="Center">
                                    <TextBlock x:Name="BrowserStatusText" Text="Checking…" FontSize="11.5" FontWeight="SemiBold" />
                                </Border>
                            </Grid>
                            <Border Style="{StaticResource RowDivider}" />
                            <Grid Style="{StaticResource SettingRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE8A5;" Style="{StaticResource Icon}" HorizontalAlignment="Left" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="PDF" FontWeight="SemiBold" />
                                    <TextBlock Text="Windows PDF renderer, PDFsharp and PdfPig. Built in, nothing to install." Style="{StaticResource Caption}" Margin="0,2,0,0" />
                                </StackPanel>
                                <Border Grid.Column="2" CornerRadius="12" Padding="10,4" VerticalAlignment="Center" Background="{DynamicResource SuccessSubtleBrush}">
                                    <TextBlock Text="Ready" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource SuccessBrush}" />
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ======================= ABOUT ======================= -->
            <ScrollViewer x:Name="ViewAbout" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel MaxWidth="860" Margin="28,24,28,32">

                    <!-- Identity -->
                    <Grid Margin="0,0,0,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="56" Height="56" CornerRadius="14" Margin="0,0,18,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="{DynamicResource BrandStartColor}" Offset="0" />
                                    <GradientStop Color="{DynamicResource BrandEndColor}" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <TextBlock Text="OG" Foreground="{DynamicResource OnAccentBrush}" FontWeight="Bold" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="OG Converter" Style="{StaticResource H1}" />
                            <!-- Filled from the assembly version, which the release workflow stamps from the tag -->
                            <TextBlock x:Name="AboutVersionText" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource GhostButton}" Click="OnOpenReleaseNotesClick" Margin="0,0,8,0"
                                    ToolTip="What changed in this version">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8A5;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Release notes" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource AccentButton}" Click="OnOpenRepoClick" Padding="16,7"
                                    ToolTip="https://github.com/Dr-At0mic/og-converter">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE943;" Style="{StaticResource Icon}" FontSize="14" Foreground="{DynamicResource OnAccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Source code" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Story -->
                    <Border Style="{StaticResource Card}" Padding="24,22" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="WHY IT EXISTS" Style="{StaticResource Overline}" Margin="0,0,0,12" />
                            <Border BorderBrush="{DynamicResource AccentBrush}" BorderThickness="3,0,0,0" Padding="16,2,0,2" Margin="0,0,0,16">
                                <TextBlock Style="{StaticResource Body}" FontSize="16" FontFamily="{StaticResource DisplayFont}" LineHeight="24"
                                           Text="“Powered by pure boredom, caffeine, and living in a world with no superpowers, no magic, and no zombie apocalypse to save us from desk jobs.”" />
                            </Border>
                            <TextBlock Style="{StaticResource Caption}" FontSize="13" LineHeight="21" Margin="0,0,0,10"
                                       Text="Online converters upload your confidential files to someone else's server, make you solve CAPTCHAs, park you in a fake 30-second queue and show you ads, all to turn a WebP into a PNG." />
                            <TextBlock Style="{StaticResource Caption}" FontSize="13" LineHeight="21"
                                       Text="OG Converter is built for developers, designers and power users who value flow. Drag a file, tap a key, let go. Everything runs on your machine: no cloud, no telemetry, no account." />
                        </StackPanel>
                    </Border>

                    <!-- Facts -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource Card}" Padding="22,20">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                    <TextBlock Text="&#xE950;" Style="{StaticResource Icon}" Foreground="{DynamicResource ModeToolsBrush}" Margin="0,0,10,0" />
                                    <TextBlock Text="Under the hood" Style="{StaticResource H2}" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,8" Text="Native Windows app on .NET 10 and WPF" />
                                <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,8" Text="Low-level keyboard and mouse hooks for the drag gesture" />
                                <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,8" Text="Explorer shell automation to find the dragged file" />
                                <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,8" Text="Uses FFmpeg, Office or LibreOffice, and Edge if they're on your PC. It only installs them when you ask." />
                                <TextBlock Style="{StaticResource Caption}" Text="Windows today. A Linux version is on the way." />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="22,20">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                    <TextBlock Text="&#xEA18;" Style="{StaticResource Icon}" Foreground="{DynamicResource SuccessBrush}" Margin="0,0,10,0" />
                                    <TextBlock Text="Privacy" Style="{StaticResource H2}" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,8" Text="Works fully offline. Files never leave your PC." />
                                <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,8" Text="No analytics, telemetry or tracking of any kind" />
                                <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,8" Text="No account, no sign-in, no license server" />
                                <TextBlock Style="{StaticResource Caption}" Text="Small footprint while waiting in the system tray" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Developers -->
                    <Border Style="{StaticResource Card}" Padding="24,22" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="DEVELOPERS" Style="{StaticResource Overline}" Margin="0,0,0,14" />
                            <UniformGrid Columns="3">
                                <UniformGrid.Resources>
                                    <Style x:Key="DevAvatar" TargetType="Border">
                                        <Setter Property="Width" Value="40" />
                                        <Setter Property="Height" Value="40" />
                                        <Setter Property="CornerRadius" Value="20" />
                                        <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
                                        <Setter Property="Margin" Value="0,0,12,0" />
                                    </Style>
                                    <Style x:Key="DevInitials" TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
