                                </StackPanel>
                                <CheckBox x:Name="OverwriteCheck" Grid.Column="2" Style="{StaticResource ToggleSwitch}" IsChecked="False" VerticalAlignment="Center"
                                          Checked="OnSettingChanged" Unchecked="OnSettingChanged" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Wheel -->
                    <TextBlock Text="Wheel" Style="{StaticResource SectionLabel}" />
                    <Border Style="{StaticResource Card}" Margin="0,0,0,24">
