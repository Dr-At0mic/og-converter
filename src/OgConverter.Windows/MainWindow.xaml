                                          Checked="OnSettingChanged" Unchecked="OnSettingChanged" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Notifications -->
                    <TextBlock Text="Notifications" Style="{StaticResource SectionLabel}" />
                    <Border Style="{StaticResource Card}" Margin="0,0,0,24">
                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xEA8F;" Style="{StaticResource Icon}" HorizontalAlignment="Left" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Show a notification when done" FontWeight="SemiBold" />
                                <TextBlock Text="A small card in the corner with Open and the result size" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                            </StackPanel>
                            <CheckBox x:Name="ShowToastCheck" Grid.Column="2" Style="{StaticResource ToggleSwitch}" IsChecked="True" VerticalAlignment="Center"
                                      Checked="OnSettingChanged" Unchecked="OnSettingChanged" />
                        </Grid>
                    </Border>

                    <!-- System -->
                    <TextBlock Text="System" Style="{StaticResource SectionLabel}" />
                    <Border Style="{StaticResource Card}" Margin="0,0,0,24">
                        <StackPanel>
                            <Grid Style="{StaticResource SettingRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE896;" Style="{StaticResource Icon}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,2,0,0" />
