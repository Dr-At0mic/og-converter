<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Everything that doesn't need a UI toolkit or Windows: conversions, compression, archives, protection, documents,
    templates, settings, updates and the portable self-test. The apps (Windows: OgConverter.Windows) plug in what is
    platform-specific through OgConverter.Services.Platform at startup.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>OgConverter.Core</AssemblyName>
    <RootNamespace>OgConverter</RootNamespace>
    <Product>OG Converter</Product>
    <!-- Release workflow overrides this from the tag (v1.2.3 → 1.2.3) -->
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- The Windows app and its self-test use a few internal helpers (built-in templates, test fixtures) -->
    <InternalsVisibleTo Include="og-converter" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="K4os.Compression.LZ4.Streams" Version="1.3.8" />
    <PackageReference Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
    <PackageReference Include="Markdig" Version="1.4.1" />
    <PackageReference Include="PdfPig" Version="0.1.16" />
    <!-- Pinned: 6.2.4 is the last MIT release. 6.5.0+ is AGPL-3.0 and requires a license key. Do not upgrade. -->
    <PackageReference Include="PDFsharp" Version="[6.2.4]" />
    <PackageReference Include="SharpCompress" Version="0.50.6" />
    <PackageReference Include="SharpZipLib" Version="1.4.2" />
    <!--
      PDFsharp asks for 8.0.1, which has known vulnerabilities. The Windows desktop runtime ships its own (newer) copy, so
      the Windows app never uses the package; plain .NET doesn't, so take the patched 8.0.2 here.
    -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="8.0.2" />
    <PackageReference Include="ZstdSharp.Port" Version="0.8.8" />
  </ItemGroup>

</Project>
