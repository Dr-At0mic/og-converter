<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>og-converter</AssemblyName>
    <RootNamespace>OgConverter</RootNamespace>
    <Product>OG Converter</Product>
    <ApplicationIcon>Assets\og-converter.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Window/taskbar icon (pack URI) and a loose copy for the tray, which loads it at the exact DPI size -->
    <Resource Include="Assets\og-converter.ico" />
    <None Include="Assets\og-converter.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
    <PackageReference Include="Markdig" Version="1.4.1" />
    <PackageReference Include="PdfPig" Version="0.1.16" />
    <!-- Pinned: 6.2.4 is the last MIT release. 6.5.0+ is AGPL-3.0 and requires a license key. Do not upgrade. -->
    <PackageReference Include="PDFsharp" Version="[6.2.4]" />
    <PackageReference Include="SharpZipLib" Version="1.4.2" />
  </ItemGroup>

</Project>
