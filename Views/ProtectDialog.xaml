<Window x:Class="OgConverter.Views.ProtectDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Protect with a password"
        Icon="pack://application:,,,/Assets/og-converter.ico"
        Width="580" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" Topmost="True" ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        Foreground="{DynamicResource TextPrimaryBrush}"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <!-- Selectable method card -->
        <Style x:Key="MethodCard" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="14,11">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid Width="18" Height="18" VerticalAlignment="Top" Margin="0,1,12,0">
                                    <Ellipse x:Name="ring" Stroke="{DynamicResource BorderStrongBrush}" StrokeThickness="1" Fill="{DynamicResource SurfaceBrush}" />
                                    <Ellipse x:Name="dot" Width="8" Height="8" Fill="{DynamicResource OnAccentBrush}" Visibility="Collapsed" />
                                </Grid>
                                <ContentPresenter Grid.Column="1" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource TextTertiaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentFaintBrush}" />
                                <Setter TargetName="ring" Property="Fill" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="ring" Property="Stroke" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="dot" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="OptionCheck" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderStrongBrush}"
            BorderThickness="1" CornerRadius="12" Margin="16" Effect="{StaticResource FlyoutShadow}">
        <StackPanel>
            <!-- Header (drag to move) -->
            <Grid MouseLeftButtonDown="OnHeaderMouseDown" Background="Transparent" Margin="24,22,24,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="36" Height="36" CornerRadius="8" Background="{DynamicResource ModeActionsSubtleBrush}" Margin="0,0,14,0" VerticalAlignment="Top">
                    <TextBlock Text="&#xE72E;" Style="{StaticResource Icon}" Foreground="{DynamicResource ModeActionsBrush}" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Protect with a password" Style="{StaticResource H2}" />
                    <TextBlock x:Name="FileInfoText" Style="{StaticResource Caption}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                </StackPanel>
            </Grid>

            <ScrollViewer x:Name="BodyScroller" MaxHeight="640" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="24,0,24,0">

                    <!-- Method -->
                    <TextBlock Text="Method" Style="{StaticResource FieldLabel}" />
                    <StackPanel x:Name="MethodList" />

                    <!-- Password -->
                    <Grid Margin="0,10,0,8">
                        <TextBlock Text="Password" FontWeight="SemiBold" VerticalAlignment="Bottom" />
                        <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Right" Padding="8,3" FontSize="12" Click="OnGenerateClick"
                                ToolTip="Create a strong random password and copy it to the clipboard">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8D7;" FontFamily="{StaticResource IconFont}" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock Text="Generate strong password" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <Grid>
                        <PasswordBox x:Name="PasswordInput" PasswordChanged="OnInputChanged" />
                        <TextBox x:Name="PasswordVisible" Visibility="Collapsed" TextChanged="OnInputChanged" FontFamily="Cascadia Mono, Consolas, Segoe UI" />
                    </Grid>

                    <!-- Strength meter -->
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="4" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="4" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="4" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="Strength0" Grid.Column="0" Height="4" CornerRadius="2" Background="{DynamicResource BorderStrongBrush}" />
                        <Border x:Name="Strength1" Grid.Column="2" Height="4" CornerRadius="2" Background="{DynamicResource BorderStrongBrush}" />
                        <Border x:Name="Strength2" Grid.Column="4" Height="4" CornerRadius="2" Background="{DynamicResource BorderStrongBrush}" />
                        <Border x:Name="Strength3" Grid.Column="6" Height="4" CornerRadius="2" Background="{DynamicResource BorderStrongBrush}" />
                        <TextBlock x:Name="StrengthText" Grid.Column="7" FontSize="11.5" Foreground="{DynamicResource TextTertiaryBrush}" Margin="10,0,0,0" MinWidth="70" />
                    </Grid>

                    <TextBlock Text="Confirm password" Style="{StaticResource FieldLabel}" Margin="0,14,0,8" />
                    <Grid>
                        <PasswordBox x:Name="ConfirmInput" PasswordChanged="OnInputChanged" />
                        <TextBox x:Name="ConfirmVisible" Visibility="Collapsed" TextChanged="OnInputChanged" FontFamily="Cascadia Mono, Consolas, Segoe UI" />
                    </Grid>
                    <CheckBox x:Name="ShowPasswordCheck" Content="Show password" Margin="0,12,0,0" FontSize="12.5"
                              Checked="OnShowPasswordChanged" Unchecked="OnShowPasswordChanged" />

                    <!-- Per-method settings -->
                    <Border Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,18,0,0">
                        <StackPanel>
                            <TextBlock Text="ENCRYPTION SETTINGS" Style="{StaticResource Overline}" Margin="0,0,0,12" />

                            <!-- PDF -->
                            <StackPanel x:Name="PdfOptions">
                                <TextBlock Text="Encryption" Style="{StaticResource FieldLabel}" />
                                <ComboBox x:Name="PdfCipherCombo" SelectionChanged="OnInputChanged">
                                    <ComboBoxItem Content="AES-256 (PDF 2.0) · recommended" IsSelected="True" />
                                    <ComboBoxItem Content="AES-128 (PDF 1.6, for older readers)" />
                                    <ComboBoxItem Content="RC4 128-bit (legacy, weak)" />
                                </ComboBox>
                                <TextBlock Text="Allow people who open it to" Style="{StaticResource FieldLabel}" Margin="0,16,0,10" />
                                <WrapPanel>
                                    <CheckBox x:Name="AllowPrintCheck" Style="{StaticResource OptionCheck}" Content="Print" IsChecked="True" Width="150" Checked="OnInputChanged" Unchecked="OnInputChanged" />
                                    <CheckBox x:Name="AllowCopyCheck" Style="{StaticResource OptionCheck}" Content="Copy text and images" IsChecked="True" Width="180" Checked="OnInputChanged" Unchecked="OnInputChanged" />
                                    <CheckBox x:Name="AllowEditCheck" Style="{StaticResource OptionCheck}" Content="Edit pages" IsChecked="True" Width="150" Checked="OnInputChanged" Unchecked="OnInputChanged" />
                                    <CheckBox x:Name="AllowCommentCheck" Style="{StaticResource OptionCheck}" Content="Comment and fill forms" IsChecked="True" Width="180" Checked="OnInputChanged" Unchecked="OnInputChanged" />
                                </WrapPanel>
                                <StackPanel x:Name="PermissionsPasswordPanel" Visibility="Collapsed">
                                    <TextBlock Text="Permissions password (optional)" Style="{StaticResource FieldLabel}" Margin="0,6,0,8" />
                                    <PasswordBox x:Name="PermissionsPasswordInput" PasswordChanged="OnInputChanged" />
                                    <TextBlock Style="{StaticResource Caption}" FontSize="11.5" Margin="0,6,0,0"
                                               Text="Lets you lift the restrictions later. Leave blank to make them permanent. Restrictions are honoured by PDF readers, not enforced by the encryption itself." />
                                </StackPanel>
                            </StackPanel>

                            <!-- Office -->
                            <StackPanel x:Name="OfficeOptions">
                                <TextBlock x:Name="OfficeCipherText" Style="{StaticResource Body}" FontSize="12.5" />
                                <TextBlock Text="Password to edit (optional)" Style="{StaticResource FieldLabel}" Margin="0,14,0,8" />
                                <PasswordBox x:Name="ModifyPasswordInput" PasswordChanged="OnInputChanged" />
                                <TextBlock Style="{StaticResource Caption}" FontSize="11.5" Margin="0,6,0,0"
                                           Text="Anyone with the open password can read it; saving changes will also need this one." />
                            </StackPanel>

                            <!-- Encrypted file -->
                            <StackPanel x:Name="VaultOptions">
                                <TextBlock Text="Cipher" Style="{StaticResource FieldLabel}" />
                                <ComboBox x:Name="VaultCipherCombo" SelectionChanged="OnInputChanged">
                                    <ComboBoxItem Content="AES-256-GCM · recommended" IsSelected="True" />
                                    <ComboBoxItem x:Name="ChaChaItem" Content="ChaCha20-Poly1305" />
                                </ComboBox>
                                <TextBlock Text="Key derivation" Style="{StaticResource FieldLabel}" Margin="0,14,0,8" />
                                <ComboBox x:Name="KdfCombo" SelectionChanged="OnInputChanged">
                                    <ComboBoxItem Content="Argon2id, 64 MiB memory-hard · recommended" IsSelected="True" />
                                    <ComboBoxItem Content="PBKDF2-HMAC-SHA512, 210,000 rounds" />
                                </ComboBox>
                                <TextBlock x:Name="VaultNote" Style="{StaticResource Caption}" FontSize="11.5" Margin="0,8,0,0" />
                            </StackPanel>

                            <!-- Password-protected archive -->
                            <StackPanel x:Name="ZipOptions">
                                <TextBlock Text="Archive format" Style="{StaticResource FieldLabel}" />
                                <ComboBox x:Name="ArchiveFormatCombo" SelectionChanged="OnInputChanged">
                                    <ComboBoxItem Content="ZIP · opens on every computer" Tag="zip" IsSelected="True" />
                                    <ComboBoxItem Content="7z · AES-256, usually the smallest" Tag="7z" />
                                    <ComboBoxItem Content="RAR · AES-256 (made with WinRAR)" Tag="rar" />
                                </ComboBox>

                                <StackPanel x:Name="ZipCipherPanel">
                                    <TextBlock Text="Encryption" Style="{StaticResource FieldLabel}" Margin="0,14,0,8" />
                                    <ComboBox x:Name="ZipCipherCombo" SelectionChanged="OnInputChanged">
                                        <ComboBoxItem Content="AES-256 (WinZip AES) · recommended" IsSelected="True" />
                                        <ComboBoxItem Content="ZipCrypto (legacy, weak)" />
                                    </ComboBox>
                                </StackPanel>
                                <CheckBox x:Name="EncryptNamesCheck" Style="{StaticResource OptionCheck}" IsChecked="True" Margin="0,14,0,0"
                                          Checked="OnInputChanged" Unchecked="OnInputChanged">
                                    <TextBlock Text="Encrypt file names too, so nothing is visible without the password" TextWrapping="Wrap" />
                                </CheckBox>

                                <TextBlock Text="Compression" Style="{StaticResource FieldLabel}" Margin="0,14,0,8" />
                                <ComboBox x:Name="ArchiveLevelCombo" SelectionChanged="OnInputChanged">
                                    <ComboBoxItem Content="Store (no compression, fastest)" Tag="store" />
                                    <ComboBoxItem Content="Normal" Tag="normal" IsSelected="True" />
                                    <ComboBoxItem Content="Maximum (smaller, slower)" Tag="max" />
                                </ComboBox>

                                <Border x:Name="ToolMissingPanel" Background="{DynamicResource WarningSubtleBrush}" CornerRadius="6" Padding="12,10" Margin="0,14,0,0" Visibility="Collapsed">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="ToolMissingText" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0" />
                                        <Button x:Name="InstallToolButton" Grid.Column="1" Padding="12,4" FontSize="12" Click="OnInstallToolClick" />
                                    </Grid>
                                </Border>
                                <TextBlock x:Name="ZipNote" Style="{StaticResource Caption}" FontSize="11.5" Margin="0,8,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Validation / hint -->
                    <Border Background="{DynamicResource InputBrush}" CornerRadius="6" Padding="12,10" Margin="0,14,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="StatusIcon" Text="&#xE946;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Top" />
                            <TextBlock x:Name="StatusText" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" MaxWidth="410" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Footer -->
            <Border Background="{DynamicResource WindowBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0"
                    CornerRadius="0,0,12,12" Padding="24,14" Margin="0,20,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" IsCancel="True" Click="OnCancelClick" Margin="0,0,8,0" MinWidth="88" />
                    <Button x:Name="ConfirmButton" Style="{StaticResource AccentButton}" Content="Protect" IsDefault="True" Click="OnConfirmClick" MinWidth="88" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</Window>
