<Window x:Class="OgConverter.Views.UnlockDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Unlock"
        Icon="pack://application:,,,/Assets/og-converter.ico"
        Width="460" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" Topmost="True" ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        Foreground="{DynamicResource TextPrimaryBrush}"
        TextOptions.TextFormattingMode="Display">

    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderStrongBrush}"
            BorderThickness="1" CornerRadius="12" Margin="16" Effect="{StaticResource FlyoutShadow}">
        <StackPanel>
            <!-- Header (drag to move) -->
            <Grid MouseLeftButtonDown="OnHeaderMouseDown" Background="Transparent" Margin="24,22,24,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="36" Height="36" CornerRadius="8" Background="{DynamicResource ModeActionsSubtleBrush}" Margin="0,0,14,0" VerticalAlignment="Top">
                    <TextBlock Text="&#xE785;" Style="{StaticResource Icon}" Foreground="{DynamicResource ModeActionsBrush}" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="HeaderTitle" Text="Unlock" Style="{StaticResource H2}" />
                    <TextBlock x:Name="FileInfoText" Style="{StaticResource Caption}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                </StackPanel>
            </Grid>

            <StackPanel Margin="24,0,24,0">
                <TextBlock Text="Password" FontWeight="SemiBold" Margin="0,0,0,8" />
                <Grid>
                    <PasswordBox x:Name="PasswordInput" PasswordChanged="OnInputChanged" />
                    <TextBox x:Name="PasswordVisible" Visibility="Collapsed" TextChanged="OnInputChanged" FontFamily="Cascadia Mono, Consolas, Segoe UI" />
                </Grid>
                <CheckBox x:Name="ShowPasswordCheck" Content="Show password" Margin="0,12,0,0" FontSize="12.5"
                          Checked="OnShowPasswordChanged" Unchecked="OnShowPasswordChanged" />

                <Border Background="{DynamicResource InputBrush}" CornerRadius="6" Padding="12,10" Margin="0,16,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="StatusIcon" Text="&#xE946;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Top" />
                        <TextBlock x:Name="StatusText" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" MaxWidth="360" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Footer -->
            <Border Background="{DynamicResource WindowBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0"
                    CornerRadius="0,0,12,12" Padding="24,14" Margin="0,22,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" IsCancel="True" Click="OnCancelClick" Margin="0,0,8,0" MinWidth="88" />
                    <Button x:Name="ConfirmButton" Style="{StaticResource AccentButton}" Content="Unlock" IsDefault="True" Click="OnConfirmClick" MinWidth="88" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</Window>
