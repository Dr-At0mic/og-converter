<Window x:Class="OgConverter.Views.ArchiveDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Archive"
        Icon="pack://application:,,,/Assets/og-converter.ico"
        Width="600" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" Topmost="True" ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        Foreground="{DynamicResource TextPrimaryBrush}"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <!-- Popular-format chip -->
        <Style x:Key="PresetChip" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" CornerRadius="14" Padding="12,5">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource TextTertiaryBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderStrongBrush}"
            BorderThickness="1" CornerRadius="12" Margin="16" Effect="{StaticResource FlyoutShadow}">
        <StackPanel>
            <!-- Header (drag to move) -->
            <Grid MouseLeftButtonDown="OnHeaderMouseDown" Background="Transparent" Margin="24,22,24,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="36" Height="36" CornerRadius="8" Background="{DynamicResource ModeActionsSubtleBrush}" Margin="0,0,14,0" VerticalAlignment="Top">
                    <TextBlock Text="&#xE7B8;" Style="{StaticResource Icon}" Foreground="{DynamicResource ModeActionsBrush}" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Create archive" Style="{StaticResource H2}" />
                    <TextBlock x:Name="FileInfoText" Style="{StaticResource Caption}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                </StackPanel>
            </Grid>

            <ScrollViewer x:Name="BodyScroller" MaxHeight="640" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="24,0,24,0">
                    <!-- Format -->
                    <TextBlock Text="Format" Style="{StaticResource FieldLabel}" />
                    <WrapPanel x:Name="PresetPanel" />
                    <ComboBox x:Name="FormatCombo" Margin="0,4,0,0" SelectionChanged="OnFormatChanged" MaxDropDownHeight="420" />

                    <!-- Compression settings for the chosen format (built in code) -->
                    <Border Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="16,14" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="COMPRESSION" Style="{StaticResource Overline}" Margin="0,0,0,12" />
                            <StackPanel x:Name="SettingsPanel" />
                        </StackPanel>
                    </Border>

                    <!-- Advanced: password -->
                    <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Margin="-8,12,0,0" Padding="8,4" Click="OnAdvancedToggled">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="AdvancedChevron" Text="&#xE76C;" FontFamily="{StaticResource IconFont}" FontSize="10" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="Advanced: password protection" FontWeight="SemiBold" />
                            <TextBlock x:Name="AdvancedBadge" Style="{StaticResource Caption}" FontSize="11.5" VerticalAlignment="Center" Margin="10,0,0,0" />
                        </StackPanel>
                    </Button>
                        <Border x:Name="AdvancedPanel" Visibility="Collapsed" Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="16,14" Margin="0,8,0,0">
                            <StackPanel>
                                <StackPanel x:Name="PasswordFields">
                                    <Grid Margin="0,0,0,8">
                                        <TextBlock Text="Password (optional)" FontWeight="SemiBold" VerticalAlignment="Bottom" />
                                        <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Right" Padding="8,3" FontSize="12" Click="OnGenerateClick"
                                                ToolTip="Create a strong random password and copy it to the clipboard">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE8D7;" FontFamily="{StaticResource IconFont}" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                <TextBlock Text="Generate strong password" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                    <Grid>
                                        <PasswordBox x:Name="PasswordInput" PasswordChanged="OnPasswordChanged" />
                                        <TextBox x:Name="PasswordVisible" Visibility="Collapsed" TextChanged="OnPasswordChanged" FontFamily="Cascadia Mono, Consolas, Segoe UI" />
                                    </Grid>
                                    <TextBlock Text="Confirm password" Style="{StaticResource FieldLabel}" Margin="0,12,0,8" />
                                    <Grid>
                                        <PasswordBox x:Name="ConfirmInput" PasswordChanged="OnPasswordChanged" />
                                        <TextBox x:Name="ConfirmVisible" Visibility="Collapsed" TextChanged="OnPasswordChanged" FontFamily="Cascadia Mono, Consolas, Segoe UI" />
                                    </Grid>
                                    <CheckBox x:Name="ShowPasswordCheck" Content="Show password" Margin="0,10,0,0" FontSize="12.5"
                                              Checked="OnShowPasswordChanged" Unchecked="OnShowPasswordChanged" />

                                    <StackPanel x:Name="ZipCipherPanel">
                                        <TextBlock Text="Encryption" Style="{StaticResource FieldLabel}" Margin="0,14,0,8" />
                                        <ComboBox x:Name="ZipCipherCombo" SelectionChanged="OnPasswordChanged">
                                            <ComboBoxItem Content="AES-256 (WinZip AES) · recommended" IsSelected="True" />
                                            <ComboBoxItem Content="ZipCrypto (legacy, weak; opens in Windows Explorer)" />
                                        </ComboBox>
                                    </StackPanel>
                                    <CheckBox x:Name="EncryptNamesCheck" IsChecked="True" Margin="0,14,0,0" FontSize="12.5"
                                              Checked="OnPasswordChanged" Unchecked="OnPasswordChanged">
                                        <TextBlock Text="Encrypt file names too, so nothing is visible without the password" TextWrapping="Wrap" />
                                    </CheckBox>
                                </StackPanel>
                                <TextBlock x:Name="PasswordNote" Style="{StaticResource Caption}" FontSize="11.5" Margin="0,10,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                    <!-- A helper this choice needs isn't installed -->
                    <Border x:Name="ToolMissingPanel" Background="{DynamicResource WarningSubtleBrush}" CornerRadius="6" Padding="12,10" Margin="0,14,0,0" Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="ToolMissingText" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <Button x:Name="InstallToolButton" Grid.Column="1" Padding="12,4" FontSize="12" Click="OnInstallToolClick" />
                        </Grid>
                    </Border>

                    <!-- Summary -->
                    <Border Background="{DynamicResource InputBrush}" CornerRadius="6" Padding="12,10" Margin="0,14,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="SummaryIcon" Text="&#xE946;" Style="{StaticResource Icon}" FontSize="12" Margin="0,1,8,0" VerticalAlignment="Top"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <StackPanel Grid.Column="1">
                                <TextBlock x:Name="SummaryText" FontSize="12" TextWrapping="Wrap" />
                                <TextBlock x:Name="WarningText" FontSize="11.5" TextWrapping="Wrap" Margin="0,4,0,0"
                                           Foreground="{DynamicResource WarningBrush}" Visibility="Collapsed" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Footer -->
            <Border Background="{DynamicResource WindowBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0"
                    CornerRadius="0,0,12,12" Padding="24,14" Margin="0,20,0,0">
                <Grid>
                    <Button Style="{StaticResource GhostButton}" Content="Reset to defaults" HorizontalAlignment="Left"
                            FontSize="12" Padding="10,5" Click="OnResetClick" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel" IsCancel="True" Click="OnCancelClick" Margin="0,0,8,0" MinWidth="88" />
                        <Button x:Name="ConfirmButton" Style="{StaticResource AccentButton}" Content="Create" IsDefault="True" Click="OnConfirmClick" MinWidth="88" />
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </Border>
</Window>
