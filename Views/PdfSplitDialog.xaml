<Window x:Class="OgConverter.Views.PdfSplitDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Split / Extract Pages"
        Icon="pack://application:,,,/Assets/og-converter.ico"
        Width="480" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" Topmost="True" ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        Foreground="{DynamicResource TextPrimaryBrush}"
        TextOptions.TextFormattingMode="Display">

    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderStrongBrush}"
            BorderThickness="1" CornerRadius="12" Margin="16" Effect="{StaticResource FlyoutShadow}">
        <StackPanel>
            <!-- Header (drag to move) -->
            <Grid MouseLeftButtonDown="OnHeaderMouseDown" Background="Transparent" Margin="24,22,24,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="36" Height="36" CornerRadius="8" Background="{DynamicResource ModeToolsSubtleBrush}" Margin="0,0,14,0" VerticalAlignment="Top">
                    <TextBlock Text="&#xE8C6;" Style="{StaticResource Icon}" Foreground="{DynamicResource ModeToolsBrush}" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Split or extract pages" Style="{StaticResource H2}" />
                    <TextBlock x:Name="FileInfoText" Style="{StaticResource Caption}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                </StackPanel>
            </Grid>

            <StackPanel Margin="24,0,24,0">
                <!-- Mode -->
                <RadioButton x:Name="ModeExtractRadio" GroupName="SplitMode" IsChecked="True" Margin="0,0,0,12"
                             Content="Extract the pages into one PDF" Checked="OnInputChanged" />
                <RadioButton x:Name="ModeEachRangeRadio" GroupName="SplitMode" Margin="0,0,0,12"
                             Content="Save each range as its own PDF" Checked="OnInputChanged" />
                <RadioButton x:Name="ModeEveryPageRadio" GroupName="SplitMode"
                             Content="Split every page into its own PDF" Checked="OnInputChanged" />

                <!-- Ranges -->
                <TextBlock Text="Pages" FontWeight="SemiBold" Margin="0,22,0,8" />
                <TextBox x:Name="RangesBox" TextChanged="OnInputChanged" FontFamily="Cascadia Mono, Consolas, Segoe UI" />
                <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0" FontSize="11.5">
                    For example <Run Text="1-3, 5, 8-" FontFamily="Cascadia Mono, Consolas" Foreground="{DynamicResource TextPrimaryBrush}" />.
                    <Run Text="8-" FontFamily="Cascadia Mono, Consolas" Foreground="{DynamicResource TextPrimaryBrush}" /> runs to the last page.
                </TextBlock>

                <!-- Live preview / validation -->
                <Border x:Name="PreviewBorder" Background="{DynamicResource InputBrush}" CornerRadius="6" Padding="12,10" Margin="0,16,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="PreviewIcon" Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0" />
                        <TextBlock x:Name="PreviewText" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" MaxWidth="360" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Footer -->
            <Border Background="{DynamicResource WindowBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0"
                    CornerRadius="0,0,12,12" Padding="24,14" Margin="0,22,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" IsCancel="True" Click="OnCancelClick" Margin="0,0,8,0" MinWidth="88" />
                    <Button x:Name="ConfirmButton" Style="{StaticResource AccentButton}" Content="Extract" IsDefault="True" Click="OnConfirmClick" MinWidth="88" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</Window>
