<Window x:Class="OgConverter.Views.PdfMergeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Merge PDFs"
        Icon="pack://application:,,,/Assets/og-converter.ico"
        Width="600" Height="520" MinWidth="480" MinHeight="400"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResizeWithGrip" Topmost="True" ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        Foreground="{StaticResource TextPrimaryBrush}"
        TextOptions.TextFormattingMode="Display">

    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderStrongBrush}"
            BorderThickness="1" CornerRadius="12" Margin="16" Effect="{StaticResource FlyoutShadow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header (drag to move) -->
            <Grid Grid.Row="0" MouseLeftButtonDown="OnHeaderMouseDown" Background="Transparent" Margin="24,22,24,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="36" Height="36" CornerRadius="8" Background="#1F3B9EFF" Margin="0,0,14,0" VerticalAlignment="Top">
                    <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" Foreground="{StaticResource ModeToolsBrush}" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Merge PDFs" Style="{StaticResource H2}" />
                    <TextBlock Text="Pages are combined from top to bottom. Drop more PDFs onto the list to add them."
                               Style="{StaticResource Caption}" Margin="0,2,0,0" />
                </StackPanel>
            </Grid>

            <!-- File list + side buttons -->
            <Grid Grid.Row="1" Margin="24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Background="{StaticResource InputBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                    <ListBox x:Name="FileList" Background="Transparent" BorderThickness="0" Padding="4"
                             Foreground="{StaticResource TextPrimaryBrush}" AllowDrop="True" Drop="OnFileListDrop" DragOver="OnFileListDragOver"
                             SelectionChanged="OnSelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Grid Margin="0,1">
                                                <Border x:Name="bd" Background="Transparent" CornerRadius="6" Padding="10,8">
                                                    <ContentPresenter />
                                                </Border>
                                                <Border x:Name="pip" Width="3" Height="16" CornerRadius="1.5" Background="{StaticResource AccentBrush}"
                                                        HorizontalAlignment="Left" Visibility="Collapsed" />
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
                                                    <Setter TargetName="pip" Property="Visibility" Value="Visible" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid ToolTip="{Binding Path}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Index}" Foreground="{StaticResource TextTertiaryBrush}" FontSize="12" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="&#xE8A5;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,10,0" />
                                    <TextBlock Grid.Column="2" Text="{Binding FileName}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="3" Text="{Binding Details}" Foreground="{StaticResource TextTertiaryBrush}" FontSize="12" Margin="12,0,0,0" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <StackPanel Grid.Column="1" Margin="12,0,0,0" Width="124">
                    <Button Click="OnAddClick" Margin="0,0,0,6" HorizontalContentAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="Add PDFs" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="RemoveButton" Click="OnRemoveClick" Margin="0,0,0,18">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="Remove" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="UpButton" Click="OnMoveUpClick" Margin="0,0,0,6">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74A;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="Move up" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="DownButton" Click="OnMoveDownClick">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74B;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="Move down" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Summary / validation -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="24,14,24,0">
                <TextBlock x:Name="SummaryIcon" Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0" />
                <TextBlock x:Name="SummaryText" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" MaxWidth="500" />
            </StackPanel>

            <!-- Footer -->
            <Border Grid.Row="3" Background="{StaticResource WindowBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0"
                    CornerRadius="0,0,12,12" Padding="24,14" Margin="0,18,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" IsCancel="True" Click="OnCancelClick" Margin="0,0,8,0" MinWidth="88" />
                    <Button x:Name="MergeButton" Style="{StaticResource AccentButton}" Content="Merge" IsDefault="True" Click="OnMergeClick" MinWidth="88" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
